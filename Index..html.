
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Indian Roblox Simulator - Prototype 2</title>
<style>
*{box-sizing:border-box}
body{margin:0;overflow:hidden;background:#87ceeb;font-family:Arial;color:white}
#game{position:fixed;inset:0}
button,select{
  background:#132b3b;color:white;border:1px solid #45d9ff;
  padding:10px 13px;border-radius:10px;font-weight:bold
}
button:active{background:#16799b}
#top{
 position:fixed;top:10px;left:10px;right:10px;
 display:flex;justify-content:space-between;gap:8px;pointer-events:none
}
.panel{background:#071521d9;border:1px solid #36cfff;border-radius:12px;padding:10px}
#money{font-size:16px;color:#7dffbd}
#info{font-size:12px;margin-top:4px}
#apps{
 position:fixed;right:10px;top:100px;width:145px;
 display:flex;flex-direction:column;gap:7px
}
#apps button{font-size:12px}
#phone{
 position:fixed;right:10px;bottom:10px;width:220px;
