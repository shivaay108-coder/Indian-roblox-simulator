<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js"></script>
<script>
"use strict";

const $=id=>document.getElementById(id);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const distance=(a,b)=>Math.hypot(a.x-b.x,a.z-b.z);

if(!window.THREE){
 document.body.innerHTML="<h2 style='padding:20px'>3D Engine load नहीं हुआ। Internet ON करके Reload करें।</h2>";
 throw new Error("Three.js unavailable");
}

/* =====================================================
   06. GLOBAL GAME DATA
===================================================== */
const places=[
 ["Home",-20,10],["School",85,85],["Bank",-90,40],
 ["Hospital",95,-65],["Shopping Mall",10,-100],
 ["Petrol Pump",-110,-70],["Garage",0,105],
 ["Office",100,0],["Restaurant / Dhaba",-65,-105],
 ["Bus Station",130,80],["Taxi Stand",-135,95],
 ["Park",20,65],["Home Stop",-30,20],
 ["Market Stop",15,-80],["Park Stop",30,70]
];

const apps=[
 ["App Store","🛍️","store"],["Play Store","▶️","play"],
 ["Bank","🏦","bank"],["Shopping","🛒","shop"],
 ["Map / GPS","🗺️","map"],["Taxi Booking","🚕","taxi"],
 ["Jobs","💼","jobs"],["Garage","🔧","garage"],
 ["Restaurant","🍔","food"],["Car Rental","🚘","rental"],
 ["Inventory","🎒","inventory"]
];

let cash=2500,bank=5000,health=100,fuel=100;
let inventory={Water:2,Food:1};
let installed=new Set(["store","play","map","jobs"]);
let rentalCars=0,ownedCars=1;
let selectedDestination=null,currentJob=null;
let busStops=[],busIndex=0,busPassengers=0;
let taxi=null,taxiState="",taxiFare=0;
let activeVehicle=null,vehicles=[],npcs=[];
let phoneOpen=false,driving=false;
let playerYaw=0,camYaw=0,camPitch=.28,camDistance=9;
let firstPerson=false;
let joy={x:0,y:0},keys={},running=false,jumpTimer=0;
let mapZoom=1,mapCenter={x:0,z:0},mapSelected=null;
let routeLine=null;
let toastTimer=0;
let lastTime=0;

/* =====================================================
   07. THREE.JS SCENE AND LIGHTING
===================================================== */
const scene=new THREE.Scene();
scene.background=new THREE.Color(0x91c8eb);
scene.fog=new THREE.Fog(0x91c8eb,180,500);

const camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,900);
const renderer=new THREE.WebGLRenderer({antialias:false,powerPreference:"high-performance"});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.3));
renderer.shadowMap.enabled=false;
$("game").appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x65775c,2));
const sun=new THREE.DirectionalLight(0xffffff,1.8);
sun.position.set(-100,150,80);scene.add(sun);

function material(color,rough=.85){
 return new THREE.MeshStandardMaterial({color,roughness:rough});
}
const M={
 grass:material(0x719b5b),road:material(0x333b45),
 line:material(0xe9e0bb),skin:material(0xffc18e),
 shirt:material(0x2578d0),pants:material(0x26385e),
 hair:material(0x292020),glass:material(0x77bbd2,.3),
 window:material(0x6db4d1,.35),roof:material(0x4b5864),
 wheel:material(0x151719),white:material(0xf4eee1),
 yellow:material(0xf0c33d),red:material(0xd94d43),
 green:material(0x32985d),blue:material(0x247bc4)
};
function cube(parent,w,h,d,mat,x,y,z){
 const o=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),mat);
 o.position.set(x,y,z);parent.add(o);return o;
}

/* =====================================================
   08. CITY GROUND, ROADS AND STREET OBJECTS
===================================================== */
cube(scene,700,.2,700,M.grass,0,-.15,0);

for(let i=-300;i<=300;i+=50){
 cube(scene,12,.05,700,M.road,i,.01,0);
 cube(scene,700,.05,12,M.road,0,.02,i);
 for(let j=-300;j<300;j+=25){
  cube(scene,.35,.06,7,M.line,i,.05,j);
  cube(scene,7,.06,.35,M.line,j,.05,i);
 }
}

function createTree(x,z){
 const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
 cube(g,.8,5,.8,material(0x76512d),0,2.5,0);
 const crown=new THREE.Mesh(new THREE.SphereGeometry(3,7,6),material(0x2f7d43));
 crown.position.y=6;g.add(crown);
}
for(let i=0;i<55;i++){
 const x=(Math.random()-.5)*500,z=(Math.random()-.5)*500;
 if(Math.abs(x%50)<14||Math.abs(z%50)<14)continue;
 createTree(x,z);
}

const buildingObjects=[];
function createBuilding(name,x,z,color,w=22,h=13,d=18){
 const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
 cube(g,w,h,d,material(color),0,h/2,0);
 cube(g,w+1,1,d+1,M.roof,0,h,0);
 for(let xx=-w/2+3;xx<w/2-1;xx+=5)
  cube(g,2.2,3,.15,M.window,xx,h*.65,d/2+.1);
 cube(g,4,5,.25,material(0x65452e),0,2.5,d/2+.2);
 buildingObjects.push({name,x,z,w,d,group:g});
 return g;
}
const buildingData=[
 ["HOME",-20,10,0xd9b68e],["SCHOOL",85,85,0xe0c568],
 ["BANK",-90,40,0x89a9c7],["HOSPITAL",95,-65,0xf0eeee],
 ["MALL",10,-100,0xb7a0d6],["PETROL PUMP",-110,-70,0x6eabbc],
 ["GARAGE",0,105,0x899eaa],["OFFICE",100,0,0x9eafc0],
 ["DHABA",-65,-105,0xc58c55],["BUS STATION",130,80,0x8eae9e],
 ["TAXI STAND",-135,95,0xe3c85c],["PARK",20,65,0x72a66a]
];
for(const b of buildingData)createBuilding(...b);

// Garage has open front: remove front wall/door and keep roof + side posts.
const garageGroup=buildingObjects.find(b=>b.name==="GARAGE").group;
garageGroup.children[0].visible=false;
cube(garageGroup,26,1,23,M.roof,0,12,0);
cube(garageGroup,1,12,1,M.roof,-12,6,0);
cube(garageGroup,1,12,1,M.roof,12,6,0);

/* =====================================================
   09. ROBLOX CHARACTER AND ANIMATIONS
===================================================== */
function createCharacter(shirt=M.shirt){
 const root=new THREE.Group();
 cube(root,1.2,1.5,.65,shirt,0,2.2,0);
 const head=cube(root,.85,.85,.85,M.skin,0,3.4,0);
 cube(root,.9,.24,.9,M.hair,0,3.85,0);
 // Character face is local -Z.
 cube(root,.12,.12,.04,material(0x202020),-.2,3.45,-.44);
 cube(root,.12,.12,.04,material(0x202020),.2,3.45,-.44);
 cube(root,.28,.05,.04,material(0x9b3636),0,3.2,-.45);
 const la=cube(root,.35,1.3,.4,M.skin,-.85,2.2,0);
 const ra=cube(root,.35,1.3,.4,M.skin,.85,2.2,0);
 const ll=cube(root,.45,1.25,.5,M.pants,-.32,.62,0);
 const rl=cube(root,.45,1.25,.5,M.pants,.32,.62,0);
 root.userData={la,ra,ll,rl,head};
 scene.add(root);return root;
}
const player=createCharacter();
player.position.set(-20,0,18);

function animateCharacter(c,t,amount,rate=1){
 if(!c||!c.userData.la)return;
 const swing=Math.sin(t*9)*.55*amount*rate;
 c.userData.la.rotation.x=swing;
 c.userData.ra.rotation.x=-swing;
 c.userData.ll.rotation.x=-swing;
 c.userData.rl.rotation.x=swing;
}
function playerPos(){return activeVehicle?activeVehicle.root.position:player.position}

/* =====================================================
   10. VEHICLE CREATION AND DRIVING
===================================================== */
function createVehicle(type,x,z,color=0x287bc1){
 const root=new THREE.Group();root.position.set(x,0,z);scene.add(root);
 const bus=type==="bus";
 cube(root,bus?3.7:2.3,bus?1.6:.85,bus?7:4,material(color),0,1.1,0);
 cube(root,bus?3.4:2,bus?1.15:.9,bus?3.7:2,M.glass,0,bus?2.15:2,0);
 const wheels=[];
 const wheelZ=bus?[-2.5,2.5]:[-1.3,1.3];
 for(const xx of [-1.2,1.2])for(const zz of wheelZ){
  const wheel=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.25,10),M.wheel);
  wheel.rotation.z=Math.PI/2;wheel.position.set(xx,.5,zz);
  root.add(wheel);wheels.push(wheel);
 }
 const v={root,type,wheels,speed:0,yaw:0,health:100,fuel:100};
 vehicles.push(v);return v;
}
const starterCar=createVehicle("car",-12,22,0x176dc4);

function enterVehicle(v){
 if(!v||driving)return;
 if(distance(player.position,v.root.position)>8)return toast("Vehicle is too far away");
 activeVehicle=v;driving=true;player.visible=false;
 $("exitBtn").style.display="block";
 toast("Entered "+v.type.toUpperCase());
}
function exitVehicle(){
 if(!activeVehicle)return;
 const p=activeVehicle.root.position;
 player.position.set(p.x+3,0,p.z+2);
 player.visible=true;activeVehicle=null;driving=false;
 $("exitBtn").style.display="none";
}
$("exitBtn").onclick=exitVehicle;

function updateVehicle(v,dt){
 if(v===activeVehicle){
  const throttle=(keys.w?1:0)-(keys.s?1:0)-joy.y;
  const steer=(keys.d?1:0)-(keys.a?1:0)+joy.x;
  v.speed+=(throttle*22-v.speed*1.5)*dt;
  v.speed=clamp(v.speed,-11,24);
  v.yaw+=steer*dt*(.8+Math.abs(v.speed)*.035);
  v.root.rotation.y=v.yaw;
  // Local forward is -Z, same as the character face.
  v.root.position.x-=Math.sin(v.yaw)*v.speed*dt;
  v.root.position.z-=Math.cos(v.yaw)*v.speed*dt;
  if(v.speed!==0&&fuel>0)fuel=Math.max(0,fuel-Math.abs(v.speed)*dt*.002);
  if(fuel<=0)v.speed=0;
 }else v.speed*=.96;
 v.wheels.forEach(w=>w.rotation.x+=v.speed*dt*1.5);
}
function nearbyVehicle(){
 const p=playerPos();let best=null,dist=8;
 for(const v of vehicles){
  const d=distance(p,v.root.position);
  if(d<dist){dist=d;best=v}
 }
 return best;
}

/* =====================================================
   11. NPC WALKING AND ANIMATIONS
===================================================== */
const npcs=[];
function spawnNPC(x,z){
 const c=createCharacter(material([0x3a9f9b,0xb56a9a,0xd4a94d,0x668bd0][Math.floor(Math.random()*4)]));
 c.position.set(x,0,z);
 c.userData.target=new THREE.Vector3(x+Math.random()*25-12,0,z+Math.random()*25-12);
 npcs.push(c);
}
for(let i=0;i<12;i++)spawnNPC((Math.random()-.5)*180,(Math.random()-.5)*180);

function updateNPCs(dt,t){
 for(const n of npcs){
  const target=n.userData.target;
  const dx=target.x-n.position.x,dz=target.z-n.position.z;
  const d=Math.hypot(dx,dz);
  if(d<2)n.userData.target.set(n.position.x+(Math.random()-.5)*30,0,n.position.z+(Math.random()-.5)*30);
  else{
   n.position.x+=dx/d*dt*1.8;
   n.position.z+=dz/d*dt*1.8;
   n.rotation.y=Math.atan2(-dx,-dz);
  }
  animateCharacter(n,t,1,.55);
 }
}

/* =====================================================
   12. GPS AND DESTINATION
===================================================== */
function clearGPS(){
 if(routeLine){scene.remove(routeLine);routeLine.geometry.dispose();routeLine=null}
}
function setGPS(place){
 if(!place)return toast("Choose a destination first");
 selectedDestination=place;
 clearGPS();
 const p=playerPos();
 const points=[new THREE.Vector3(p.x,.45,p.z),new THREE.Vector3(place[1],.45,place[2])];
 routeLine=new THREE.Line(
  new THREE.BufferGeometry().setFromPoints(points),
  new THREE.LineBasicMaterial({color:0x00eaff})
 );
 scene.add(routeLine);
 $("selectedPlace").textContent="Destination: "+place[0];
 toast("GPS set: "+place[0]);
 drawWorldMap();
}
function distanceToDestination(){
 if(!selectedDestination)return 0;
 const p=playerPos();
 return Math.round(Math.hypot(p.x-selectedDestination[1],p.z-selectedDestination[2]));
}

/* =====================================================
   13. PHONE HOME AND APP INSTALLATION
===================================================== */
function openPhone(){
 phoneOpen=true;$("phone").style.display="block";
 renderPhone();
 $("appPage").innerHTML="<h3>Welcome to Indian Life Phone</h3><p>Select an app above.</p>";
}
function closePhone(){
 phoneOpen=false;$("phone").style.display="none";
}
$("phoneBtn").onclick=openPhone;
$("phoneClose").onclick=closePhone;

function renderPhone(){
 const grid=$("appGrid");grid.innerHTML="";
 for(const a of apps){
  const installedApp=installed.has(a[2]);
  const b=document.createElement("button");
  b.className="appIcon";
  const emoji=document.createElement("span");
  emoji.className="emoji";emoji.textContent=a[1];
  const name=document.createElement("small");
  name.textContent=a[0];
  const status=document.createElement("small");
  status.textContent=installedApp?"OPEN":"INSTALL";
  b.append(emoji,name,document.createElement("br"),status);
  b.onclick=()=>openApp(a[2]);
  grid.appendChild(b);
 }
}
function page(title,html){
 $("appPage").innerHTML="<h3>"+title+"</h3>"+html;
}
function openApp(id){
 if(!installed.has(id)&&id!=="store"&&id!=="play"){
  page("Install "+id.toUpperCase(),"<p>This app is not installed.</p>");
  const b=document.createElement("button");
  b.textContent="INSTALL APP";
  b.onclick=()=>{installed.add(id);saveGame();renderPhone();openApp(id);toast("App installed")};
  $("appPage").appendChild(b);return;
 }
 switch(id){
  case "store":showStore("store");break;
  case "play":showStore("play");break;
  case "bank":showBank();break;
  case "shop":showShopping();break;
  case "map":closePhone();openMap();break;
  case "taxi":showTaxi();break;
  case "jobs":showJobs();break;
  case "garage":showGarage();break;
  case "food":showRestaurant();break;
  case "rental":showRental();break;
  case "inventory":showInventory();break;
 }
}
function showStore(which){
 let html="<p>Game Store — Apps install locally in this game.</p>";
 for(const a of apps){
  if(a[2]==="store"||a[2]==="play")continue;
  html+='<div class="item">'+a[1]+' <b>'+a[0]+'</b> ';
  html+=installed.has(a[2])?"<b>INSTALLED</b>":
   '<button data-install="'+a[2]+'">INSTALL</button>';
  html+="</div>";
 }
 page(which==="play"?"▶️ Play Store":"🛍️ App Store",html);
 $("appPage").querySelectorAll("[data-install]").forEach(b=>{
  b.onclick=()=>installApp(b.dataset.install);
 });
}
function installApp(id){
 installed.add(id);saveGame();renderPhone();showStore("store");
 toast("App installed successfully");
}

/* =====================================================
   14. BANKING SYSTEM
===================================================== */
  function showBank(){
 page("🏦 BANK",
 '<p>Cash Wallet: ₹'+cash+'</p><p>Bank Balance: ₹'+bank+'</p>'+
 '<input id="bankAmount" type="number" min="1" placeholder="Enter amount">'+
 '<button data-action="deposit">DEPOSIT</button>'+
 '<button data-action="withdraw">WITHDRAW</button>');
 $("appPage").querySelector('[data-action="deposit"]').onclick=()=>bankTransaction("deposit");
 $("appPage").querySelector('[data-action="withdraw"]').onclick=()=>bankTransaction("withdraw");
}
function bankTransaction(type){
 const amount=Math.floor(Number($("bankAmount").value));
