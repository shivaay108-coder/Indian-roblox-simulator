function moveVehicleTo(v,x,z,dt,speed){
 const dx=x-v.root.position.x,dz=z-v.root.position.z;
 const d=Math.hypot(dx,dz);
 if(d>1){
  v.root.position.x+=dx/d*speed*dt;
  v.root.position.z+=dz/d*speed*dt;
  v.root.rotation.y=Math.atan2(-dx,-dz);
  v.wheels.forEach(w=>w.rotation.x+=dt*speed);
 }
 return d;
}
function updateTaxi(dt){
 if(!taxi)return;
 if(taxiState==="coming"){
  const p=playerPos();
  const d=moveVehicleTo(taxi,p.x+3,p.z+3,dt,12);
  if(d<4){taxiState="arrived";toast("Taxi arrived. Press ENTER TAXI.");}
 }
 if(taxiState==="riding"){
  const d=taxi.destination;
  const dist=moveVehicleTo(taxi,d[1],d[2],dt,16);
  if(dist<3){
   cash-=taxiFare;
   taxi.root.position.set(d[1],0,d[2]);
   player.position.set(d[1],0,d[2]+3);
   player.visible=true;activeVehicle=null;driving=false;
   $("exitBtn").style.display="none";
   scene.remove(taxi.root);
   vehicles=vehicles.filter(v=>v!==taxi);
   taxi=null;taxiState="";
   saveGame();updateHUD();toast("Taxi journey completed!");
  }
 }
}
function enterTaxi(){
 if(!taxi||taxiState!=="arrived")return toast("Taxi is not here yet");
 enterVehicle(taxi);taxiState="riding";
 toast("Taxi journey started");
}

