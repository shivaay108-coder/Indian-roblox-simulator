 if(firstPerson&&!driving){
  camera.position.set(p.x,p.y+3.25,p.z);
  camera.rotation.order="YXZ";
  camera.rotation.y=camYaw;
  camera.rotation.x=camPitch-.2;
  return;
 }
 const target=new THREE.Vector3(p.x,driving?2.2:2.6,p.z);
 const d=driving?camDistance+2:camDistance;
 camera.position.set(
  target.x+Math.sin(camYaw)*Math.cos(camPitch)*d,
  target.y+Math.sin(camPitch)*d+1,
  target.z+Math.cos(camYaw)*Math.cos(camPitch)*d
 );
 camera.lookAt(target);
}

