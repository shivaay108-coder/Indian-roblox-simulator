function saveGame(){
 const data={
  cash,bank,health,fuel,inventory,installed:[...installed],
  rentalCars,ownedCars
 };
 try{localStorage.setItem("IndianRobloxLifeP5",JSON.stringify(data))}
 catch(e){toast("Save storage unavailable")}
}
function loadGame(){
 try{
  const raw=localStorage.getItem("IndianRobloxLifeP5");
  if(!raw)return;
  const d=JSON.parse(raw);
  if(Number.isFinite(d.cash))cash=d.cash;
  if(Number.isFinite(d.bank))bank=d.bank;
  if(Number.isFinite(d.health))health=d.health;
  if(Number.isFinite(d.fuel))fuel=d.fuel;
  if(d.inventory&&typeof d.inventory==="object")inventory=d.inventory;
  if(Array.isArray(d.installed))installed=new Set(d.installed);
  if(Number.isFinite(d.rentalCars))rentalCars=d.rentalCars;
  if(Number.isFinite(d.ownedCars))ownedCars=d.ownedCars;
 }catch(e){console.warn("Save data invalid; starting new game")}
}

/* =====================================================
   31. MAIN GAME LOOP
===================================================== */
function gameLoop(now){
 requestAnimationFrame(gameLoop);
 const dt=Math.min((now-lastTime)/1000||0,.04);
 lastTime=now;
 const t=now/1000;

 updatePlayer(dt,t);
 for(const v of vehicles)updateVehicle(v,dt);
 updateTaxi(dt);
 updateNPCs(dt,t);
 updateCamera();
 drawMiniMap();
 if($("worldMap").style.display==="block")drawWorldMap();
 updateHUD();
 renderer.render(scene,camera);
}

/* =====================================================
   32. STARTUP AND RESIZE
===================================================== */
loadGame();
renderPhone();
updateHUD();
requestAnimationFrame(gameLoop);

addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

setInterval(saveGame,10000);
addEventListener("beforeunload",saveGame);

/* =====================================================
   33. PHONE AND MAP KEYBOARD SUPPORT
===================================================== */
$("phone").addEventListener("click",e=>{
 if(e.target=== $("phone"))closePhone();
});
$("worldMap").addEventListener("click",e=>{
 if(e.target===$("worldMap"))$("worldMap").style.display="none";
});

/* =====================================================
   34. SAFETY AGAINST ACCIDENTAL PAGE SCROLL
===================================================== */
document.addEventListener("contextmenu",e=>e.preventDefault());
document.addEventListener("touchmove",e=>{
 if(!e.target.closest("#appPage")&&!e.target.closest("#worldMap"))e.preventDefault();
},{passive:false});

/* =====================================================
   35. GAME READY
===================================================== */
toast("Indian Roblox Life Simulator loaded!");
</script>
</body>
</html>
