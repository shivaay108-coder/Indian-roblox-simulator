const worldCanvas=$("worldCanvas"),wctx=worldCanvas.getContext("2d");
function drawWorldMap(){
 const w=worldCanvas.width,h=worldCanvas.height;
 wctx.clearRect(0,0,w,h);
 wctx.fillStyle="#172b3c";wctx.fillRect(0,0,w,h);
 const scale=mapZoom*1.25;
 const sx=x=>w/2+(x-mapCenter.x)*scale;
 const sy=z=>h/2+(z-mapCenter.z)*scale;
 wctx.strokeStyle="#60727f";wctx.lineWidth=7*mapZoom;
 for(let i=-300;i<=300;i+=50){
  wctx.beginPath();wctx.moveTo(sx(i),0);wctx.lineTo(sx(i),h);wctx.stroke();
  wctx.beginPath();wctx.moveTo(0,sy(i));wctx.lineTo(w,sy(i));wctx.stroke();
 }
 for(const p of places){
  const x=sx(p[1]),y=sy(p[2]);
  if(x<0||x>w||y<0||y>h)continue;
  wctx.fillStyle="#f0c84f";wctx.beginPath();wctx.arc(x,y,6,0,7);wctx.fill();
  wctx.fillStyle="white";wctx.font="13px Arial";wctx.fillText(p[0],x+8,y-8);
 }
 const p=playerPos();
 wctx.save();wctx.translate(sx(p.x),sy(p.z));wctx.rotate(playerYaw);
 wctx.fillStyle="#28e4ff";wctx.beginPath();
 wctx.moveTo(0,-13);wctx.lineTo(-8,9);wctx.lineTo(8,9);wctx.closePath();wctx.fill();
 wctx.restore();
 if(selectedDestination){
  wctx.strokeStyle="#00eaff";wctx.lineWidth=3;
  wctx.beginPath();wctx.moveTo(sx(p.x),sy(p.z));
  wctx.lineTo(sx(selectedDestination[1]),sy(selectedDestination[2]));wctx.stroke();
 }
}
function openMap(){
 $("worldMap").style.display="block";
 mapCenter={x:playerPos().x,z:playerPos().z};
 drawWorldMap();
}
$("mapClose").onclick=()=>$("worldMap").style.display="none";
$("zoomIn").onclick=()=>{mapZoom=Math.min(5,mapZoom*1.25);drawWorldMap()};
$("zoomOut").onclick=()=>{mapZoom=Math.max(.3,mapZoom/1.25);drawWorldMap()};
$("mapCenter").onclick=()=>{mapCenter={x:playerPos().x,z:playerPos().z};drawWorldMap()};
$("setDestination").onclick=()=>{
 if(!mapSelected)return toast("Select a named location");
 setGPS(mapSelected);$("worldMap").style.display="none";
};
let mapDrag=null;
worldCanvas.addEventListener("pointerdown",e=>{
 mapDrag={x:e.clientX,y:e.clientY,cx:mapCenter.x,cz:mapCenter.z,moved:false};
 worldCanvas.setPointerCapture(e.pointerId);
});
worldCanvas.addEventListener("pointermove",e=>{
 if(!mapDrag)return;
 const dx=e.clientX-mapDrag.x,dy=e.clientY-mapDrag.y;
 if(Math.hypot(dx,dy)>5)mapDrag.moved=true;
 if(mapDrag.moved){
  const rect=worldCanvas.getBoundingClientRect();
  const scale=mapZoom*1.25;
  mapCenter.x=mapDrag.cx-dx/rect.width*worldCanvas.width/scale;
  mapCenter.z=mapDrag.cz-dy/rect.height*worldCanvas.height/scale;
  drawWorldMap();
 }
});
worldCanvas.addEventListener("pointerup",e=>{
 if(!mapDrag)return;
 if(!mapDrag.moved){
  const rect=worldCanvas.getBoundingClientRect();
  const wx=(e.clientX-rect.left-rect.width/2)/rect.width*worldCanvas.width/(mapZoom*1.25)+mapCenter.x;
  const wz=(e.clientY-rect.top-rect.height/2)/rect.height*worldCanvas.height/(mapZoom*1.25)+mapCenter.z;
  let best=null,dist=1e9;
  for(const p of places){
   const d=Math.hypot(p[1]-wx,p[2]-wz);
   if(d<dist){best=p;dist=d}
  }
  if(best&&dist<28){
   mapSelected=best;$("selectedPlace").textContent="Destination: "+best[0];
   toast("Selected "+best[0]);drawWorldMap();
  }
 }
 mapDrag=null;
});

