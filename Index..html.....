/* INTERACTIONS */
function nearestLocation(){
 let best=null,dist=999;
 for(const [name,p] of Object.entries(locations)){
  const d=Math.hypot(player.root.position.x-p.x,player.root.position.z-p.z);
  if(d<dist){dist=d;best=name}
 }
 return dist<14?best:null;
}
function interact(){
 if(driving&&activeVehicle===bus){
  if(job?.stage==="pickup")arriveAtBusStop();
  if(job?.stage==="drop")finishBusDrop();
  return;
 }
 if(taxi&&taxi.phase==="arrived"&&!driving){
  enterTaxi();return;
 }
 const near=nearestLocation();
 if(near==="Garage"){
  const damaged=vehicles.find(v=>v===activeVehicle);
  if(damaged){damaged.health=100;toast("Vehicle repaired!")}
  else toast("Drive a vehicle into the open Garage to repair it.");
 }else if(near==="Restaurant")showFood();
 else if(near==="Bank")showBank();
 else if(near==="School")toast("Welcome to School.");
 else if(near)toast("You are near "+near);
 else toast("Nothing nearby to interact with.");
}
function enterTaxi(){
 if(!taxi||taxi.phase!=="arrived")return;
 taxi.phase="riding";taxi.doorTarget=0;
 playerVisible=false;scene.remove(player.root);
 activeVehicle=taxi;driving=true;
 toast("Taxi ride started.");
}
function enterExit(){
 if(!driving){
  if(taxi&&taxi.phase==="arrived"){enterTaxi();return}
  let best=null,dist=8;
  for(const v of vehicles){
   const d=v.root.position.distanceTo(player.root.position);
   if(d<dist){dist=d;best=v}
  }
  if(!best){toast("No vehicle nearby");return}
  activeVehicle=best;driving=true;playerVisible=false;
  scene.remove(player.root);
  best.doorTarget=1;
  setTimeout(()=>{if(activeVehicle===best)best.doorTarget=0},900);
  toast("Entered "+best.type);
 }else{
  if(activeVehicle===taxi&&taxi?.phase==="riding"){
   toast("Please wait until the taxi reaches destination.");return;
  }
const v=activeVehicle;
  if(!v)return;
  const out=V(2,0,0).applyAxisAngle(V(0,1,0),v.root.rotation.y);
  player.root.position.set(v.root.position.x+out.x,0,v.root.position.z+out.z);
  scene.add(player.root);playerVisible=true;
  v.doorTarget=1;setTimeout(()=>v.doorTarget=0,900);
  activeVehicle=null;driving=false;
  if(v===bus)toast("You exited the School Bus.");
  else toast("You exited the vehicle.");
 }
}

/* CAMERA */
const cameraTarget=V(0,1,0);
function updateCamera(dt){
 let target;
 if(driving&&activeVehicle){
  target=activeVehicle.root.position.clone().add(V(0,1.3,0));
 }else target=player.root.position.clone().add(V(0,1.5,0));
 const dist=cameraDistance;
 const offset=V(Math.sin(cameraYaw)*dist*Math.cos(cameraPitch),
                2+Math.sin(cameraPitch)*dist,
                Math.cos(cameraYaw)*dist*Math.cos(cameraPitch));
 const desired=target.clone().add(offset);
 camera.position.lerp(desired,1-Math.pow(.001,dt));
 camera.lookAt(target);
}

/* MINIMAP + GPS */
const mini=document.getElementById("mini"),ctx=mini.getContext("2d");
function worldToMap(x,z){
 return {x:110+x*.42,y:110+z*.42};
}
function drawMap(){
 ctx.clearRect(0,0,220,220);
 ctx.fillStyle="#263b4b";ctx.fillRect(0,0,220,220);
 ctx.strokeStyle="#9baab4";ctx.lineWidth=5;
 for(let p=-200;p<=200;p+=50){
  let a=worldToMap(p,-220),b=worldToMap(p,220);
  ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();
  a=worldToMap(-220,p);b=worldToMap(220,p);
  ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();
 }
 for(const [name,p] of Object.entries(locations)){
  if(name.includes("Stop"))continue;
  const m=worldToMap(p.x,p.z);
  ctx.fillStyle="#f5cf54";ctx.fillRect(m.x-3,m.y-3,6,6);
 }
 const pos=driving&&activeVehicle?activeVehicle.root.position:player.root.position;
 if(currentDestination){
  const dest=worldToMap(currentDestination.x,currentDestination.z);
  const me=worldToMap(pos.x,pos.z);
  ctx.strokeStyle="#41e8ff";ctx.lineWidth=3;ctx.setLineDash([5,4]);
  ctx.beginPath();ctx.moveTo(me.x,me.y);ctx.lineTo(dest.x,dest.y);ctx.stroke();
  ctx.setLineDash([]);
  ctx.fillStyle="#ff6464";ctx.beginPath();ctx.arc(dest.x,dest.y,5,0,Math.PI*2);ctx.fill();
 }
 const m=worldToMap(pos.x,pos.z);
 ctx.fillStyle="#50ff8b";ctx.beginPath();ctx.arc(m.x,m.y,6,0,Math.PI*2);ctx.fill();
 ctx.strokeStyle="white";ctx.lineWidth=2;ctx.stroke();
}

