/* SAVE / LOAD */
function saveGame(){
 try{
  localStorage.setItem("robloxLifeP5",JSON.stringify({wallet,bank,day,
   x:player.root.position.x,z:player.root.position.z}));
 }catch(e){}
}
function loadGame(){
 try{
  const d=JSON.parse(localStorage.getItem("robloxLifeP5")||"null");
  if(d){
   wallet=Number(d.wallet)||5000;bank=Number(d.bank)||0;day=d.day||1;
   player.root.position.set(Number(d.x)||0,0,Number(d.z)||12);
  }
 }catch(e){}
}
loadGame();
updateHUD();

/* MAIN LOOP */
let saveTimer=0,dayTimer=0;
function animate(){
 requestAnimationFrame(animate);
 const dt=Math.min(clock.getDelta(),.04);
 movePlayer(dt);
 vehicles.forEach(v=>updateVehicle(v,dt));
 updateNPCs(dt);
 updateTaxi(dt);
 updatePassengers(dt);
 updateFood();
 if(job&&bus){
  if(job.stage==="pickup"){
   const p=locations[pickupNames[job.stop]];
   if(p&&Math.hypot(bus.root.position.x-p.x,bus.root.position.z-p.z)<10
      &&Math.abs(bus.speed)<1.2)arriveAtBusStop();
  }else finishBusDrop();
 }
 updateCamera(dt);
 drawMap();
 updateHUD();
 saveTimer+=dt;dayTimer+=dt;
 if(saveTimer>8){saveGame();saveTimer=0}
 if(dayTimer>120){day++;dayTimer=0;saveGame()}
 renderer.render(scene,camera);
}
animate();

