function updateCarDriving(dt){

 const car=game.car;

 const turn=
  (keys["a"]||keys["arrowleft"]?-1:0)+
   (keys["d"]||keys["arrowright"]?1:0);

 const accel=
  (keys["w"]||keys["arrowup"]?1:0)-
  (keys["s"]||keys["arrowdown"]?1:0);

 vehicleSpeed+=accel*.008;

 vehicleSpeed*=.985;

 vehicleSpeed=Math.max(-.2,Math.min(.5,vehicleSpeed));

 car.rotation.y-=turn*.035;

 car.position.x+=Math.sin(car.rotation.y)*vehicleSpeed;

 car.position.z+=Math.cos(car.rotation.y)*vehicleSpeed;

 car.userData.wheels.forEach(w=>{
  w.rotation.x+=vehicleSpeed*2;
 });

 player.position.copy(car.position);

 player.position.y=.1;

 player.rotation.y=car.rotation.y;
}

function toggleVehicle(){

 if(game.inCar){

  game.inCar=false;

  player.position.x+=2;

  game.car=null;

  vehicleSpeed=0;

  toast("You exited the car");

  return;
 }

 interact();
}

/* =====================================
   15. INTERACTION
===================================== */

function interact(){

 if(game.inCar){

  toggleVehicle();

  return;
 }

 let nearest=null;
 let distance=Infinity;

 ownedCarMeshes.forEach(car=>{

  const d=player.position.distanceTo(car.position);

  if(d<distance){

   distance=d;
   nearest=car;
  }
 });

 if(nearest&&distance<6){

  game.car=nearest;
  game.inCar=true;

  game.carName=nearest.userData.name;

  toast("Entered "+game.carName);

 }else{

  toast("No vehicle nearby");
 }
}

