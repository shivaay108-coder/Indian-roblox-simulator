<script>
"use strict";

/* =====================================
   1. GAME DATA
===================================== */

const game={
 money:55000,
 health:100,
 hunger:100,

 storage:500,
 usedStorage:260,

 running:false,
 inCar:false,
 car:null,
 carName:"",

 job:null,
 jobBusy:false,

 ownedCars:[],
 rentalCars:[],

 homeFood:[],

 bankBalance:0,
 account:"",

 day:1,
 started:false,

 businessIncome:0,
 lastRentalCollection:0,

 lastJobTime:0,
 homeLevel:1
};

let installedApps=[
 "Wallet",
 "Maps & GPS",
 "Settings",
 "Play Store"
];

const carTypes=[
 {
  name:"Basic Hatchback",
  price:8000,
  speed:.12,
  color:0xd9d9d9
 },
 {
  name:"Sedan",
  price:20000,
  speed:.16,
  color:0x2255cc
 },
 {
  name:"SUV",
  price:35000,
  speed:.19,
  color:0x222222
 },
 {
  name:"Sports Car",
  price:50000,
  speed:.25,
  color:0xcc2222
 },
 {
  name:"Supercar",
  price:150000,
  speed:.32,
  color:0xffaa00
 },
 {
  name:"Hypercar",
  price:300000,
  speed:.40,
  color:0x11aaaa
 }
];

const rentalRates={
 "Basic Hatchback":250,
 "Sedan":500,
