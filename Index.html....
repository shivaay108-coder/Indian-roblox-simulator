 "Sports Car":1800,
 "Supercar":3500,
 "Hypercar":6000
};

const jobs=[
 {name:"Food Delivery",pay:500},
 {name:"Construction Worker",pay:800},
 {name:"Shop Worker",pay:450},
 {name:"Mechanic",pay:700},
 {name:"Office Worker",pay:900},
 {name:"Security Guard",pay:650},
 {name:"Taxi Driver",pay:750},
 {name:"Bus Driver",pay:1000}
];

const foods=[
 {name:"Burger",price:150},
 {name:"Pizza",price:300},
 {name:"Indian Thali",price:250}
];

/* =====================================
   2. THREE JS VARIABLES
===================================== */

let scene;
let camera;
let renderer;
let clock;

let player;
let playerBody;
let playerHead;

let buildings=[];
let traffic=[];
let ownedCarMeshes=[];
let npcs=[];

let keys={};

let moveX=0;
let moveZ=0;

let playerY=0;
let jumpVelocity=0;

let vehicleSpeed=0;
let cameraAngle=0;

let destination=null;

const WORLD_SIZE=220;

/* =====================================
   3. START GAME
===================================== */

function startGame(){

 if(typeof THREE==="undefined"){
  alert("Internet connection required to load 3D graphics.");
  return;
 }

 document.getElementById("startScreen").style.display="none";

 game.started=true;

 createWorld();

 updateHUD();

 toast("Welcome to Indian City!");
}

/* =====================================
   4. CREATE WORLD
===================================== */

function createWorld(){

 scene=new THREE.Scene();

 scene.background=new THREE.Color(0x91c7ed);

 scene.fog=new THREE.Fog(0x91c7ed,75,240);

 camera=new THREE.PerspectiveCamera(
  65,
  innerWidth/innerHeight,
  .1,
  500
 );

 renderer=new THREE.WebGLRenderer({
  antialias:true
 });

 renderer.setSize(innerWidth,innerHeight);

 renderer.setPixelRatio(
  Math.min(devicePixelRatio,1.5)
 );

 renderer.shadowMap.enabled=true;

 document.getElementById("game").appendChild(renderer.domElement);

 clock=new THREE.Clock();

 const skyLight=new THREE.HemisphereLight(
  0xffffff,
  0x526b52,
  1.5
 );

 scene.add(skyLight);

 const sun=new THREE.DirectionalLight(
  0xffffff,
  1.4
 );

 sun.position.set(35,60,25);

 sun.castShadow=true;

 scene.add(sun);

 const ground=new THREE.Mesh(
  new THREE.PlaneGeometry(WORLD_SIZE,WORLD_SIZE),
  new THREE.MeshStandardMaterial({
   color:0x62a65b
  })
 );

 ground.rotation.x=-Math.PI/2;

 ground.receiveShadow=true;

 scene.add(ground);

 createCityRoads();

 createBuildings();

 createTrees();

 createStreetLights();

 createPlayer();

 createNPCs();

 createTraffic();

 window.addEventListener("resize",resize);

 camera.position.set(0,6,10);

 animate();
}

/* =====================================
   5. ROADS
===================================== */

function createCityRoads(){

 createRoad(0,0,220,14);
 createRoad(0,0,14,220);

 createRoad(0,40,220,9);
 createRoad(40,0,9,220);

 createRoad(-60,0,8,220);
 createRoad(0,-60,220,8);
}

function createRoad(x,z,w,h){

 const road=new THREE.Mesh(
  new THREE.BoxGeometry(w,.12,h),
  new THREE.MeshStandardMaterial({
   color:0x34383c
  })
 );

 road.position.set(x,.07,z);

 road.receiveShadow=true;

 scene.add(road);

 if(w>h){

  for(let i=-w/2+5;i<w/2;i+=12){

   const line=new THREE.Mesh(
    new THREE.BoxGeometry(4,.025,.16),
    new THREE.MeshBasicMaterial({
     color:0xffffff
    })
   );

   line.position.set(x+i,.15,z);

   scene.add(line);
  }

 }else{

  for(let i=-h/2+5;i<h/2;i+=12){

   const line=new THREE.Mesh(
    new THREE.BoxGeometry(.16,.025,4),
    new THREE.MeshBasicMaterial({
     color:0xffffff
    })
   );

   line.position.set(x,.15,z+i);

   scene.add(line);
  }
 }
}

/* =====================================
   6. BLOCK BUILDINGS
===================================== */

function createBuildings(){

 const colors=[
  0xd6bda4,
  0xb4d2e0,
  0xe2b6a2,
  0xbfc6d2,
  0xe6d6a9,
  0xa8c8a5
 ];

 for(let x=-90;x<=90;x+=20){

  for(let z=-90;z<=90;z+=20){

   if(
    Math.abs(x)<18||
    Math.abs(z)<18||
    Math.abs(x-40)<10||
    Math.abs(z-40)<10
   )continue;

   const height=8+Math.random()*22;

   const building=new THREE.Mesh(
    new THREE.BoxGeometry(11,height,11),
    new THREE.MeshStandardMaterial({
     color:colors[Math.floor(Math.random()*colors.length)]
    })
   );

   building.position.set(x,height/2,z);

   building.castShadow=true;
   building.receiveShadow=true;

   scene.add(building);

   buildings.push(building);

   createWindows(x,z,height);

   createRoof(x,z,height);
  }
 }
}

function createWindows(x,z,height){

 const windowMat=new THREE.MeshStandardMaterial({
  color:0x70c5e8,
  emissive:0x102c40
 });

 for(let y=2;y<height-1;y+=3){

  for(let wx=-3;wx<=3;wx+=3){

   const win=new THREE.Mesh(
    new THREE.BoxGeometry(1.3,1.3,.08),
    windowMat
   );

   win.position.set(x+wx,y,z+5.55);

   scene.add(win);
  }
 }
}

function createRoof(x,z,height){

 const roof=new THREE.Mesh(
  new THREE.BoxGeometry(11.3,.4,11.3),
  new THREE.MeshStandardMaterial({
   color:0x454c54
  })
 );

 roof.position.set(x,height+.15,z);

 scene.add(roof);
}

/* =====================================
   7. BLOCK TREES
===================================== */

function createTrees(){

 for(let i=0;i<65;i++){

  const x=(Math.random()-.5)*190;
  const z=(Math.random()-.5)*190;

  if(Math.abs(x)<15||Math.abs(z)<15)continue;

  const trunk=new THREE.Mesh(
   new THREE.BoxGeometry(.6,2,.6),
   new THREE.MeshStandardMaterial({
    color:0x754629
   })
  );

  trunk.position.set(x,1,z);

  scene.add(trunk);

  const leaves=new THREE.Mesh(
   new THREE.BoxGeometry(3,3,3),
   new THREE.MeshStandardMaterial({
    color:0x23833d
   })
  );

  leaves.position.set(x,3.5,z);

  scene.add(leaves);
 }
}

/* =====================================
   8. STREET LIGHTS
===================================== */

function createStreetLights(){

 for(let x=-90;x<=90;x+=30){

  const pole=new THREE.Mesh(
   new THREE.BoxGeometry(.25,5,.25),
   new THREE.MeshStandardMaterial({
    color:0x333333
   })
  );

  pole.position.set(x,2.5,9);

  scene.add(pole);

  const lamp=new THREE.Mesh(
   new THREE.BoxGeometry(1,.3,.5),
   new THREE.MeshStandardMaterial({
    color:0xffffbb,
    emissive:0x554422
   })
  );

  lamp.position.set(x,5,9);

  scene.add(lamp);
 }
}

/* =====================================
   9. BLOCK PLAYER
===================================== */

function createPlayer(){

 player=new THREE.Group();

 const skin=new THREE.MeshStandardMaterial({
  color:0xe7b68d
 });

 const shirt=new THREE.MeshStandardMaterial({
  color:0x1675cb
 });

 const pants=new THREE.MeshStandardMaterial({
  color:0x222d47
 });

 const hair=new THREE.MeshStandardMaterial({
  color:0x241a17
 });

 const black=new THREE.MeshStandardMaterial({
  color:0x111111
 });

 // Body
 playerBody=new THREE.Mesh(
  new THREE.BoxGeometry(1,1.15,.55),
  shirt
 );

 playerBody.position.y=1.65;

 player.add(playerBody);

 // Block Head
 playerHead=new THREE.Mesh(
  new THREE.BoxGeometry(.8,.8,.8),
  skin
 );

 playerHead.position.y=2.65;

 player.add(playerHead);

 // Hair
 const hairMesh=new THREE.Mesh(
  new THREE.BoxGeometry(.85,.3,.85),
  hair
 );

 hairMesh.position.y=3.15;

 player.add(hairMesh);

 // Eyes
 for(let x of [-.19,.19]){

  const eye=new THREE.Mesh(
   new THREE.BoxGeometry(.09,.09,.04),
   black
  );

  eye.position.set(x,2.72,.41);

  player.add(eye);
 }

 // Mouth
 const mouth=new THREE.Mesh(
  new THREE.BoxGeometry(.2,.045,.04),
  black
 );

 mouth.position.set(0,2.48,.42);

 player.add(mouth);

 // Arms and legs
 player.userData.limbs=[];

 for(let side of [-1,1]){

  const armPivot=new THREE.Group();

  armPivot.position.set(side*.67,2.1,0);

  const arm=new THREE.Mesh(
   new THREE.BoxGeometry(.3,.95,.35),
   skin
  );

  arm.position.y=-.45;

  armPivot.add(arm);

  player.add(armPivot);

  player.userData.limbs.push(armPivot);

  const legPivot=new THREE.Group();

  legPivot.position.set(side*.25,1.05,0);

  const leg=new THREE.Mesh(
   new THREE.BoxGeometry(.38,1,.4),
   pants
  );

  leg.position.y=-.5;

  legPivot.add(leg);

  player.add(legPivot);

  player.userData.limbs.push(legPivot);
 }

 player.position.set(0,0,0);

 scene.add(player);
}

/* =====================================
   10. BLOCK NPC
===================================== */

function createNPC(x,z,color){

 const npc=new THREE.Group();

 const body=new THREE.Mesh(
  new THREE.BoxGeometry(.8,1,.5),
  new THREE.MeshStandardMaterial({color})
 );

 body.position.y=1.5;

 npc.add(body);

 const head=new THREE.Mesh(
  new THREE.BoxGeometry(.7,.7,.7),
  new THREE.MeshStandardMaterial({
   color:0xe6b58d
  })
 );

 head.position.y=2.35;

 npc.add(head);

 const limbs=[];

 for(let side of [-1,1]){

  const arm=new THREE.Group();

  arm.position.set(side*.5,1.9,0);

  const armMesh=new THREE.Mesh(
   new THREE.BoxGeometry(.22,.8,.25),
   new THREE.MeshStandardMaterial({
    color:0xe6b58d
   })
  );

  armMesh.position.y=-.4;

  arm.add(armMesh);

  npc.add(arm);

  limbs.push(arm);

  const leg=new THREE.Group();

  leg.position.set(side*.2,1,0);

  const legMesh=new THREE.Mesh(
   new THREE.BoxGeometry(.3,.8,.3),
   new THREE.MeshStandardMaterial({
    color:0x303d55
   })
  );

  legMesh.position.y=-.4;

  leg.add(legMesh);

  npc.add(leg);

  limbs.push(leg);
 }

 npc.position.set(x,0,z);

 npc.userData={
  limbs,
  direction:Math.random()*Math.PI*2,
  speed:.015+Math.random()*.015,
  changeTime:0
 };

 scene.add(npc);

 npcs.push(npc);
}

function createNPCs(){

 const colors=[
  0x2288cc,
  0xc74a4a,
  0x28a36a,
  0xc58b2d,
  0x8855aa
 ];

 for(let i=0;i<12;i++){

  createNPC(
   (Math.random()-.5)*100,
   (Math.random()-.5)*100,
   colors[i%colors.length]
  );
 }
}

function updateNPCs(dt){

 npcs.forEach(npc=>{

  const data=npc.userData;

  data.changeTime+=dt;

  if(data.changeTime>3){

   data.changeTime=0;

   data.direction+=(Math.random()-.5)*2;
  }

  npc.position.x+=Math.sin(data.direction)*data.speed;
  npc.position.z+=Math.cos(data.direction)*data.speed;

  npc.rotation.y=data.direction;

  const t=performance.now()*.006;

  data.limbs.forEach((limb,i)=>{
   limb.rotation.x=Math.sin(t+i*Math.PI)*.35;
  });

  if(
   Math.abs(npc.position.x)>105||
   Math.abs(npc.position.z)>105
  ){
   data.direction+=Math.PI;
  }
 });
}

/* =====================================
   11. BLOCK CARS
===================================== */

function createCarMesh(color){

 const car=new THREE.Group();

 const body=new THREE.Mesh(
  new THREE.BoxGeometry(2.2,.7,4),
  new THREE.MeshStandardMaterial({
   color,
   metalness:.45,
   roughness:.4
  })
 );

 body.position.y=.8;

 car.add(body);

 const cabin=new THREE.Mesh(
  new THREE.BoxGeometry(1.65,.85,1.9),
  new THREE.MeshStandardMaterial({
   color:0x28475b,
   metalness:.2,
   roughness:.3
  })
 );

 cabin.position.set(0,1.55,-.15);

 car.add(cabin);

 const wheelPivots=[];

 for(let x of [-1,1]){

  for(let z of [-1.3,1.3]){

   const wheel=new THREE.Mesh(
    new THREE.BoxGeometry(.35,.75,.75),
    new THREE.MeshStandardMaterial({
     color:0x161616
    })
   );

   wheel.position.set(x,.42,z);

   car.add(wheel);

   wheelPivots.push(wheel);
  }
 }

 const frontLights=new THREE.Mesh(
  new THREE.BoxGeometry(1.5,.18,.1),
  new THREE.MeshStandardMaterial({
   color:0xffffcc,
   emissive:0x665522
  })
 );

 frontLights.position.set(0,.85,2.02);

 car.add(frontLights);

 car.userData={
  wheels:wheelPivots,
  speed:.15,
  traffic:false
 };

 return car;
}

function createTraffic(){

 for(let i=0;i<7;i++){

  const car=createCarMesh(0x3377aa);

  car.position.set(-80+i*25,.1,8);

  car.userData.traffic=true;

  car.userData.direction=1;

  scene.add(car);

  traffic.push(car);
 }
}

function updateTraffic(dt){

 traffic.forEach(car=>{

  car.position.x+=car.userData.direction*dt*5;

  car.userData.wheels.forEach(w=>{
   w.rotation.x+=dt*5;
  });

  if(car.position.x>110){
   car.position.x=-110;
  }
 });
}

/* =====================================
   12. PLAYER MOVEMENT
===================================== */

function updatePlayer(dt){

 if(game.inCar&&game.car){

  updateCarDriving(dt);

  return;
 }

 let x=moveX;
 let z=moveZ;

 if(keys["w"]||keys["arrowup"])z=-1;
 if(keys["s"]||keys["arrowdown"])z=1;
 if(keys["a"]||keys["arrowleft"])x=-1;
 if(keys["d"]||keys["arrowright"])x=1;

 const length=Math.hypot(x,z);

 if(length>0){

  x/=length;
  z/=length;

  const speed=game.running?.18:.09;

  player.position.x+=(
   x*Math.cos(cameraAngle)+
   z*Math.sin(cameraAngle)
  )*speed;

  player.position.z+=(
   -z*Math.cos(cameraAngle)+
   x*Math.sin(cameraAngle)
  )*speed;

  player.rotation.y=Math.atan2(x,-z);

  animatePlayerWalk();

 }else{

  animatePlayerIdle();
 }

 player.position.x=Math.max(-105,Math.min(105,player.position.x));
 player.position.z=Math.max(-105,Math.min(105,player.position.z));

 if(jumpVelocity!==0||playerY>0){

  jumpVelocity-=.018;

  playerY+=jumpVelocity;

  if(playerY<=0){

   playerY=0;
   jumpVelocity=0;
  }

  player.position.y=playerY;
 }
}

function animatePlayerWalk(){

 const t=performance.now()*.012;

 player.userData.limbs.forEach((limb,i)=>{

  limb.rotation.x=Math.sin(t+i*Math.PI)*.65;
 });
}

function animatePlayerIdle(){

 player.userData.limbs.forEach(limb=>{

  limb.rotation.x*=.8;
  limb.rotation.z*=.8;
 });
}

/* =====================================
   13. JUMP
===================================== */

function jump(){

 if(!game.inCar&&playerY===0){

  jumpVelocity=.25;
 }
}

/* =====================================
   14. CAR DRIVING
===================================== */

function updateCarDriving(dt){

 const car=game.car;

 const turn=
  (keys["a"]||keys["arrowleft"]?-1:0)+
  (keys["d"]||keys["arrowright"]?1:0);

 const accel=
  (keys["w"]||keys["arrowup"]?1:0)-
