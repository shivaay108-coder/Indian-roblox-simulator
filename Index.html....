===================================== */

function showTaxi(){

 setContent("🚕 Taxi Service",`

  <p>Choose your destination.</p>

  <button onclick="callTaxi(0,0,'City Center')">
   City Center
  </button>

  <button onclick="callTaxi(40,40,'Shopping Mall')">
   Shopping Mall
  </button>

  <button onclick="callTaxi(-40,40,'Hospital')">
   Hospital
  </button>

  <button onclick="callTaxi(40,-40,'Police Station')">
   Police Station
  </button>

  <p>Taxi Fare: ₹200</p>

 `);
}

function callTaxi(x,z,name){

 if(game.money<200){

  toast("Insufficient balance");

  return;
 }

 if(game.inCar){

  toast("Exit your vehicle first");

  return;
 }

 game.money-=200;

 closePanel();

 const taxi=createCarMesh(0xffcc22);

 taxi.position.set(
  player.position.x+12,
  0,
  player.position.z+10
 );

 scene.add(taxi);

 toast("Taxi is coming...");

 let counter=0;

 const arrival=setInterval(()=>{

  counter++;

  taxi.position.lerp(player.position,.12);

  if(counter>30){

   clearInterval(arrival);

   game.inCar=true;

   game.car=taxi;

   game.carName="Taxi";

   toast("Taxi arrived! Journey started.");

   let step=0;

   const journey=setInterval(()=>{

    step++;

    taxi.position.lerp(
     new THREE.Vector3(x,0,z),
     .025
    );

    player.position.copy(taxi.position);

    if(step>=100){

     clearInterval(journey);

     game.inCar=false;

     game.car=null;

     player.position.set(x,0,z);

     scene.remove(taxi);

     toast("Reached "+name);

     updateHUD();
    }

   },50);
  }

 },100);
}

