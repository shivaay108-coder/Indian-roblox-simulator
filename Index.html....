   12. PLAYER MOVEMENT
===================================== */

function updatePlayer(dt){

 if(game.inCar&&game.car){

  updateCarDriving(dt);

  return;
 }

 let x=moveX;
 let z=moveZ;

 if(keys["w"]||keys["arrowup"])z=-1;
 if(keys["s"]||keys["arrowdown"])z=1;
 if(keys["a"]||keys["arrowleft"])x=-1;
 if(keys["d"]||keys["arrowright"])x=1;

 const length=Math.hypot(x,z);

 if(length>0){

  x/=length;
  z/=length;

  const speed=game.running?.18:.09;

  player.position.x+=(
   x*Math.cos(cameraAngle)+
   z*Math.sin(cameraAngle)
  )*speed;

  player.position.z+=(
   -z*Math.cos(cameraAngle)+
   x*Math.sin(cameraAngle)
  )*speed;

  player.rotation.y=Math.atan2(x,-z);

  animatePlayerWalk();

 }else{

  animatePlayerIdle();
 }

 player.position.x=Math.max(-105,Math.min(105,player.position.x));
 player.position.z=Math.max(-105,Math.min(105,player.position.z));

 if(jumpVelocity!==0||playerY>0){

  jumpVelocity-=.018;

  playerY+=jumpVelocity;

  if(playerY<=0){

   playerY=0;
   jumpVelocity=0;
  }

  player.position.y=playerY;
 }
}

function animatePlayerWalk(){

 const t=performance.now()*.012;

 player.userData.limbs.forEach((limb,i)=>{

  limb.rotation.x=Math.sin(t+i*Math.PI)*.65;
 });
}

function animatePlayerIdle(){

 player.userData.limbs.forEach(limb=>{

  limb.rotation.x*=.8;
  limb.rotation.z*=.8;
 });
}

