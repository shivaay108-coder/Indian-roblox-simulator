   16. CAMERA
===================================== */

function updateCamera(){

 if(!player)return;

 const target=game.inCar&&game.car?
  game.car.position:
  player.position;

 const distance=9;

 const desired=new THREE.Vector3(
  target.x+Math.sin(cameraAngle)*distance,
  target.y+5,
  target.z+Math.cos(cameraAngle)*distance
 );

 camera.position.lerp(desired,.09);

 camera.lookAt(
  target.x,
  target.y+1.5,
  target.z
 );
}

/* =====================================
   17. MAIN LOOP
===================================== */

function animate(){

 requestAnimationFrame(animate);

 if(!renderer)return;

 const dt=Math.min(clock.getDelta(),.05);

 if(game.started){

  updatePlayer(dt);

  updateTraffic(dt);

  updateNPCs(dt);

  updateCamera();

  game.hunger=Math.max(
   0,
   game.hunger-dt*.025
  );

  if(game.hunger===0){

   game.health=Math.max(
    1,
    game.health-dt*.05
   );
  }

  updateHUD();
 }

 renderer.render(scene,camera);
}

