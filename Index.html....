function installApp(name,size){

 if(installedApps.includes(name)){

  toast("Already installed");

  return;
 }

 if(game.usedStorage+size>game.storage){

  toast("Not enough storage");

  return;
 }

 installedApps.push(name);

 game.usedStorage+=size;

 toast(name+" installed!");

 showStore();
}

