/* =====================================
   32. SAVE SYSTEM
===================================== */

function saveGame(){

 const data={

  money:game.money,
  health:game.health,
  hunger:game.hunger,

  storage:game.storage,
  usedStorage:game.usedStorage,

  installedApps,
  ownedCars:game.ownedCars,
  rentalCars:game.rentalCars,

  homeFood:game.homeFood,

  bankBalance:game.bankBalance,
  account:game.account,

  businessIncome:game.businessIncome,
  lastRentalCollection:game.lastRentalCollection,

  homeLevel:game.homeLevel
 };

 try{

  localStorage.setItem(
   "IndianRobloxLifeSimP5",
   JSON.stringify(data)
  );

  toast("Game saved successfully!");

 }catch(error){

  toast("Save failed");
 }
}

function loadGame(){

 try{

  const raw=localStorage.getItem(
   "IndianRobloxLifeSimP5"
  );

  if(!raw){

   toast("No saved game found");

   return;
  }

  const data=JSON.parse(raw);

  game.money=data.money??55000;
  game.health=data.health??100;
  game.hunger=data.hunger??100;

  game.storage=data.storage??500;
  game.usedStorage=data.usedStorage??260;

  installedApps=data.installedApps||installedApps;

  game.ownedCars=data.ownedCars||[];
  game.rentalCars=data.rentalCars||[];

  game.homeFood=data.homeFood||[];

  game.bankBalance=data.bankBalance||0;
  game.account=data.account||"";

  game.businessIncome=data.businessIncome||0;
  game.lastRentalCollection=data.lastRentalCollection||0;

  game.homeLevel=data.homeLevel||1;

  toast("Game loaded!");

  updateHUD();

 }catch(error){

  toast("Unable to load saved game");
 }
}

