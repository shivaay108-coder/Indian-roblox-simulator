/* =====================================
   26. CAR RENTAL BUSINESS
===================================== */

function showBusiness(){

 let html=`

  <h3>🏢 Your Car Rental Business</h3>

  <p>Rent your owned vehicles to NPC customers.</p>

  <p class="small">
   Daily rental income is collected once per game day.
  </p>

 `;

 if(game.ownedCars.length===0){

  html+="<p>First buy a car from Garage.</p>";

 }else{

  game.ownedCars.forEach((car,index)=>{

   const listing=game.rentalCars.find(
    r=>r.carIndex===index
   );

   const rate=rentalRates[car.name]||250;

   html+=`

    <div class="card">

     <b>${car.name}</b>

     <p>Rental Rate: ₹${rate}/day</p>

     <p>Status: ${listing?"Listed for Rent":"Not Listed"}</p>

     ${
      listing
      ? `<button onclick="removeRental(${index})">Remove Listing</button>`
      : `<button onclick="listRental(${index})">Rent Out This Car</button>`
     }

    </div>

   `;
  });
 }

 html+=`

  <hr>

  <h3>Business Earnings</h3>

  <p>Available Income: ₹${game.businessIncome}</p>

  <button onclick="collectRentalIncome()">
   Collect Rental Income
  </button>

 `;

 setContent("🏢 Car Rental Business",html);
}

function listRental(index){

 const car=game.ownedCars[index];

 if(!car)return;

 if(game.rentalCars.some(r=>r.carIndex===index)){

  toast("This car is already listed");

  return;
 }

 const rate=rentalRates[car.name]||250;

 game.rentalCars.push({
  carIndex:index,
  rate,
  rented:false
 });

 toast(car.name+" listed for rent!");

 showBusiness();
}

function removeRental(index){

 game.rentalCars=game.rentalCars.filter(
  r=>r.carIndex!==index
 );

 toast("Car rental listing removed");

 showBusiness();
}

function collectRentalIncome(){

 const now=Date.now();

 const DAY_LENGTH=120000;

 if(game.rentalCars.length===0){

  toast("No cars listed for rent");

  return;
 }

 if(
  game.lastRentalCollection!==0&&
  now-game.lastRentalCollection<DAY_LENGTH
 ){

  const remaining=Math.ceil(
   (DAY_LENGTH-(now-game.lastRentalCollection))/1000
  );

  toast("Next rent collection in "+remaining+" seconds");

  return;
 }

 let income=0;

 game.rentalCars.forEach(listing=>{

  income+=listing.rate;
 });

 game.businessIncome+=income;

 game.money+=income;

 game.lastRentalCollection=now;

 toast("Rental income received: ₹"+income);

 updateHUD();

 showBusiness();
}

