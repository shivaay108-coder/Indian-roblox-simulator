===================================== */

function showBank(){

 if(!game.account){

  game.account=String(
   Math.floor(1000000000+Math.random()*8999999999)
  );
 }

 setContent("🏦 Banking",`

  <h3>Account: ${game.account}</h3>

  <h3>Bank: ₹${game.bankBalance}</h3>

  <h3>Wallet: ₹${game.money}</h3>

  <input id="bankAmount" type="number" min="1" placeholder="Enter amount">

  <button onclick="bankTransfer('deposit')">Deposit</button>

  <button onclick="bankTransfer('withdraw')">Withdraw</button>

  <p class="small">Virtual game banking system.</p>

 `);
}

function bankTransfer(type){

 const amount=Number(
  document.getElementById("bankAmount").value
 );

 if(!Number.isFinite(amount)||amount<=0){

  toast("Enter a valid amount");

  return;
 }

 if(type==="deposit"){

  if(amount>game.money){

   toast("Insufficient wallet balance");

   return;
  }

  game.money-=amount;

  game.bankBalance+=amount;

 }else{

  if(amount>game.bankBalance){

   toast("Insufficient bank balance");

   return;
  }

  game.bankBalance-=amount;

  game.money+=amount;
 }

 showBank();

 updateHUD();
}

