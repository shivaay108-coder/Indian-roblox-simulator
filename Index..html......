/* GPS ROAD WAYPOINT ROUTE */
function routeWaypoints(from,to){
 // Route uses the nearest horizontal/vertical road grid.
 const grid=50;
 const snap=n=>Math.round(n/grid)*grid;
 const sx=snap(from.x),sz=snap(from.z),tx=snap(to.x),tz=snap(to.z);
 return [from,V(sx,0,from.z),V(sx,0,tz),V(to.x,0,tz),to];
}

