  if(d<12&&Math.abs(bus.speed)<1.1){
   if(job.stage==="pickup")pickupChildren();
   else completeBusJob();
  }
 }
 updateCamera(dt);
 drawMini();
 if($("mapOverlay").style.display==="block")drawWorldMap();
 updateHUD();
 saveTimer+=dt;dayTimer+=dt;
 if(saveTimer>8){save();saveTimer=0}
 if(dayTimer>120){day++;dayTimer=0;save()}
 renderer.render(scene,camera);
}
function resize(){
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
 renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
}
addEventListener("resize",()=>{
 resize();
 if($("mapOverlay").style.display==="block"){resizeWorldMap();drawWorldMap()}
});
addEventListener("pagehide",save);

load();updateHUD();updateMission();animate();
mapCenter.copy(playerPos());
$("phoneClock").textContent="09:00";

/* DOUBLE TAP TO REQUEST FULLSCREEN + LANDSCAPE LOCK */
document.body.addEventListener("dblclick",async()=>{
 try{
  if(!document.fullscreenElement)await document.documentElement.requestFullscreen();
  if(screen.orientation?.lock)await screen.orientation.lock("landscape");
 }catch(e){}
});
</script>
