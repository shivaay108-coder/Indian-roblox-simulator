/* MOVEMENT */
function movePlayer(dt){
 if(driving)return;
 let f=(keys.w||keys.arrowup?1:0)-(keys.s||keys.arrowdown?1:0)-joy.y;
 let s=(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0)+joy.x;
 const l=Math.hypot(f,s);if(l>1){f/=l;s/=l}
 const speed=isRunning?9:5;
 const dx=(Math.sin(yaw)*f+Math.cos(yaw)*s)*speed*dt;
 const dz=(-Math.cos(yaw)*f+Math.sin(yaw)*s)*speed*dt;
 const nx=player.root.position.x+dx,nz=player.root.position.z+dz;
 if(!collision(nx,player.root.position.z))player.root.position.x=nx;
 if(!collision(player.root.position.x,nz))player.root.position.z=nz;
 if(l>.08)player.root.rotation.y=Math.atan2(dx,dz);
 if(isJumping){
  player.root.position.y+=jumpV*dt;jumpV-=18*dt;
  if(player.root.position.y<=0){player.root.position.y=0;isJumping=false;player.anim="idle"}
 }
 animateRig(player,dt,l>.08,isRunning?1.6:1);
}
function updateVehicle(v,dt){
 if(v===activeVehicle&&driving&&v.phase!=="riding"){
  const throttle=(keys.w||keys.arrowup?1:0)-(keys.s||keys.arrowdown?1:0)-joy.y;
  const steer=(keys.d||keys.arrowright?1:0)-(keys.a||keys.arrowleft?1:0)+joy.x;
  v.speed+=throttle*13*dt;v.speed*=Math.pow(.985,dt*60);
  v.speed=Math.max(-10,Math.min(28,v.speed));
  v.steer=THREE.MathUtils.lerp(v.steer,steer,.15);
  if(Math.abs(v.speed)>.2){
   v.root.rotation.y+=v.steer*dt*v.speed*.045;
   const nx=v.root.position.x+Math.sin(v.root.rotation.y)*v.speed*dt;
   const nz=v.root.position.z+Math.cos(v.root.rotation.y)*v.speed*dt;
   if(!collision(nx,nz)){v.root.position.x=nx;v.root.position.z=nz}
   else v.speed=0;
  }
  vehicleSpeed=Math.abs(v.speed)*3.6;
 }else if(v!==taxi||taxi?.phase!=="riding"){
  vehicleSpeed=0;
 }
 for(const w of v.wheels){
  w.w.rotation.x+=v.speed*dt*1.6;
  if(w.front)w.pivot.rotation.y=v.steer*.45;
 }
 v.body.position.y=.04+Math.abs(v.speed)*.002*Math.sin(clock.elapsedTime*14);
 v.body.rotation.z=-v.steer*.025*Math.min(1,Math.abs(v.speed)/10);
 v.doorAngle=THREE.MathUtils.lerp(v.doorAngle,v.doorTarget,dt*5);
 v.door.rotation.y=v.doorAngle;
}

/* VEHICLE ENTER / EXIT */
function enterExit(){
 if(!driving){
  if(taxi&&taxi.phase==="arrived"){enterTaxi();return}
  let best=null,d=8;
  for(const v of vehicles){
   const q=v.root.position.distanceTo(player.root.position);
   if(q<d){d=q;best=v}
  }
  if(!best){toast("No vehicle nearby");return}
  activeVehicle=best;driving=true;playerVisible=false;
  scene.remove(player.root);best.doorTarget=1;
  setTimeout(()=>{if(activeVehicle===best)best.doorTarget=0},700);
  toast("Entered "+best.type);
 }else{
  if(taxi&&activeVehicle===taxi&&taxi.phase==="riding"){
   toast("Taxi is travelling. Wait until destination.");return;
  }
  const v=activeVehicle;if(!v)return;
  const out=V(2,0,0).applyAxisAngle(V(0,1,0),v.root.rotation.y);
  player.root.position.set(v.root.position.x+out.x,0,v.root.position.z+out.z);
  scene.add(player.root);playerVisible=true;v.doorTarget=1;
  setTimeout(()=>v.doorTarget=0,700);
  activeVehicle=null;driving=false;vehicleSpeed=0;
  toast("Exited vehicle");
 }
}
function enterTaxi(){
 if(!taxi||taxi.phase!=="arrived")return;
 taxi.phase="riding";taxi.doorTarget=0;
 activeVehicle=taxi;driving=true;playerVisible=false;scene.remove(player.root);
 toast("Taxi journey started.");
}

