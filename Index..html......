 const target=(driving&&activeVehicle?activeVehicle.root.position:player.root.position)
  .clone().add(V(0,1.4,0));
 const offset=V(Math.sin(yaw)*camDistance*Math.cos(pitch),
  Math.sin(pitch)*camDistance+1,
  Math.cos(yaw)*camDistance*Math.cos(pitch));
 const desired=target.clone().add(offset);
 camera.position.lerp(desired,1-Math.pow(.001,dt));
 camera.lookAt(target);
}

