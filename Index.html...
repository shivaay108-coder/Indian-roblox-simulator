   GARAGE & CARS
========================= */
function showGarage(){
 let html="<h3>Car Showroom</h3>";
 carTypes.forEach((c,i)=>{
  html+=`<div class="row"><span>${c.name}<br>₹${c.price}</span>
  <button onclick="buyCar(${i})">Buy</button></div>`;
 });
