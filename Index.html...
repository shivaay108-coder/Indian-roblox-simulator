}
function spawnCar(i){
 if(game.inCar||game.flying){toast("Exit current vehicle first");return}
 const data=game.ownedCars[i];
 const car=createCarMesh(data.color);
 car.position.set(player.position.x+3,.2,player.position.z);
 car.userData.name=data.name;
 car.userData.speed=data.speed;
 scene.add(car);cars.push(car);
 game.car=car;game.inCar=true;game.carName=data.name;
 closePanel();toast(data.name+" spawned. Press F to exit");
}

/* =========================
   RENTAL BUSINESS
========================= */
const rentRates=[
 {name:"Basic Hatchback",rate:250},
 {name:"Sedan",rate:500},
 {name:"SUV",rate:900},
 {name:"Sports Car",rate:1800},
 {name:"Supercar",rate:3500},
 {name:"Hypercar",rate:6000}
];
function showBusiness(){
 let html="<h3>Car Rental Business</h3>";
 game.ownedCars.forEach((c,i)=>{
  const listed=game.rentalCars.some(r=>r.index===i);
  const rate=rentRates.find(r=>r.name===c.name)?.rate||250;
  html+=`<p>${c.name} - ₹${rate}/day</p>`;
  html+=listed?`<button onclick="removeListing(${i})">Remove Listing</button>`:
  `<button onclick="listCar(${i},${rate})">List for Rent</button>`;
 });
 html+=`<hr><p>Business income: ₹${game.businessIncome}</p>
 <button onclick="collectBusiness()">Collect Daily Rent</button>`;
 setContent("🏢 Business",html);
}
function listCar(index,rate){
 if(game.rentalCars.some(r=>r.index===index)){toast("Already listed");return}
 game.rentalCars.push({index,rate});
 toast("Car listed for rental");
 showBusiness();
}
function removeListing(index){
 game.rentalCars=game.rentalCars.filter(r=>r.index!==index);
 toast("Listing removed");showBusiness();
}
function collectBusiness(){
 const today=Math.floor(Date.now()/86400000);
 if(game.lastBusinessDay===today){toast("Today's rent already collected");return}
 if(!game.rentalCars.length){toast("No cars listed");return}
 let income=0;
 game.rentalCars.forEach(r=>income+=r.rate);
 game.lastBusinessDay=today;
 game.businessIncome+=income;game.money+=income;
 toast("Daily rent collected: ₹"+income);
 showBusiness();updateHUD();
}

