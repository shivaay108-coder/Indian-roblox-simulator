/* =========================
   SAVE / LOAD
========================= */
function saveGame(){
 const data={
  money:game.money,health:game.health,hunger:game.hunger,
  storage:game.storage,usedStorage:game.usedStorage,
  installedApps,ownedCars:game.ownedCars,
  homeFood:game.homeFood,bankBalance,account:game.account
 };
 try{
  localStorage.setItem("indianLifeSimP5",JSON.stringify(data));
   toast("Game saved on this device");
 }catch(e){toast("Save failed")}
}
function loadGame(){
 try{
  const raw=localStorage.getItem("indianLifeSimP5");
  if(!raw){toast("No saved game found");return}
  const d=JSON.parse(raw);
  game.money=d.money??game.money;
  game.health=d.health??100;
  game.hunger=d.hunger??100;
  game.storage=d.storage??500;
  game.usedStorage=d.usedStorage??260;
  installedApps=d.installedApps||installedApps;
  game.ownedCars=d.ownedCars||[];
  game.homeFood=d.homeFood||[];
  bankBalance=d.bankBalance||0;
  game.account=d.account||"";
  toast("Saved game loaded");
  updateHUD();
 }catch(e){toast("Save data could not be loaded")}
}

/* =========================
   MAP
========================= */
function drawMap(){
 const canvas=document.getElementById("mapCanvas");
 if(!canvas)return;
 const ctx=canvas.getContext("2d");
 canvas.width=canvas.clientWidth*2;
 canvas.height=canvas.clientHeight*2;
 ctx.fillStyle="#244b3b";
 ctx.fillRect(0,0,canvas.width,canvas.height);
 ctx.strokeStyle="#aab9bd";ctx.lineWidth=12;
 ctx.beginPath();
 ctx.moveTo(canvas.width/2,0);ctx.lineTo(canvas.width/2,canvas.height);
 ctx.moveTo(0,canvas.height/2);ctx.lineTo(canvas.width,canvas.height/2);
 ctx.stroke();
 ctx.fillStyle="#fff";
 const px=canvas.width/2+player.position.x*1.4;
 const pz=canvas.height/2+player.position.z*1.4;
 ctx.beginPath();ctx.arc(px,pz,9,0,Math.PI*2);ctx.fill();
 ctx.fillText("YOU",px+10,pz-10);
}
function setDestination(x,z){
 targetPosition.set(x,0,z);
 toast("GPS destination set");
}

