/* =========================
   FLYING ARMOR RENTAL
========================= */
function showArmor(){
 setContent("🦾 Flying Armor Rental",`
 <h3>Red-Gold Powered Armor</h3>
 <p>Original superhero-inspired flying suit.</p>
 <p>Rental price: ₹500 per minute</p>
 <p>Assembly time: up to 10 seconds</p>
 <button onclick="rentArmor(1)">Rent for 1 Minute - ₹500</button>
 <button onclick="rentArmor(3)">Rent for 3 Minutes - ₹1,500</button>
 <button onclick="rentArmor(5)">Rent for 5 Minutes - ₹2,500</button>
 <p class="small">Armor has flight controls. No real-money purchase.</p>`);
}
function makeArmorPart(color,size){
 const mesh=new THREE.Mesh(
  new THREE.BoxGeometry(size[0],size[1],size[2]),
  new THREE.MeshStandardMaterial({
   color,metalness:.85,roughness:.2,
   emissive:color,emissiveIntensity:.08
  })
 );
 mesh.castShadow=true;
 return mesh;
}
function rentArmor(minutes){
 if(game.armor||game.flying){toast("Armor already active");return}
 if(game.inCar){toast("Exit vehicle before renting armor");return}
 const cost=minutes*500;
 if(game.money<cost){toast("Not enough coins");return}
 game.money-=cost;
 game.armor={minutes};
 game.armorTime=minutes*60;
 closePanel();
 toast("Armor dispatched! Parts are arriving...");
 createArmorParts();
 updateHUD();
}
function createArmorParts(){
 const red=0xb51e28,gold=0xe6a928;
 const parts=[
  {name:"Chest",color:red,size:[.95,1.1,.65],offset:[0,1.6,0]},
  {name:"Helmet",color:red,size:[.75,.8,.75],offset:[0,2.6,0]},
  {name:"Left Arm",color:red,size:[.3,.9,.35],offset:[-.68,1.6,0]},
  {name:"Right Arm",color:red,size:[.3,.9,.35],offset:[.68,1.6,0]},
  {name:"Left Leg",color:red,size:[.38,.9,.4],offset:[-.25,.55,0]},
  {name:"Right Leg",color:red,size:[.38,.9,.4],offset:[.25,.55,0]},
  {name:"Left Shoulder",color:gold,size:[.42,.35,.48],offset:[-.65,2.05,0]},
  {name:"Right Shoulder",color:gold,size:[.42,.35,.48],offset:[.65,2.05,0]}
 ];
 game.armorParts=[];
 parts.forEach((p,i)=>{
  const mesh=makeArmorPart(p.color,p.size);
  mesh.position.set(
   player.position.x+(Math.random()-.5)*35,
   player.position.y+8+Math.random()*12,
   player.position.z+(Math.random()-.5)*35
  );
  scene.add(mesh);
  game.armorParts.push({mesh,offset:p.offset,index:i,attached:false});
 });
 let partIndex=0;
 const attach=setInterval(()=>{
  if(partIndex>=game.armorParts.length){
   clearInterval(attach);
   game.flying=true;
   player.position.y=2;
   toast("Armor assembled! Flight enabled.");
   return;
  }
  const part=game.armorParts[partIndex];
  part.attached=true;
  partIndex++;
 },1100);
 game.armorAttachTimer=attach;
}
function updateArmor(dt){
 if(!game.armor)return;
 game.armorParts.forEach(p=>{
  if(p.attached){
   const target=new THREE.Vector3(
    player.position.x+p.offset[0],
    player.position.y+p.offset[1],
    player.position.z+p.offset[2]
   );
   p.mesh.position.lerp(target,.18);
   p.mesh.rotation.y=player.rotation.y;
  }else{
   p.mesh.position.lerp(
    new THREE.Vector3(player.position.x,player.position.y+2,player.position.z),.025
   );
  }
 });
 if(game.flying){
  game.armorTime-=dt;
  if(game.armorTime<=0)endArmor();
 }
}
function endArmor(){
 if(!game.armor)return;
 game.flying=false;
 game.armorParts.forEach(p=>scene.remove(p.mesh));
 game.armorParts=[];
 game.armor=null;
 player.position.y=0;
 toast("Rental ended. Armor returned.");
}
function showArmorStatus(){
 if(!game.armor){toast("No active armor");return}
 toast("Armor remaining: "+Math.ceil(game.armorTime)+" seconds");
}

