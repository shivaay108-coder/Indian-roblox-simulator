/* =========================
   TAXI SYSTEM
========================= */
function showTaxi(){
 setContent("🚕 Taxi Service",`
 <p>Choose your destination.</p>
 <button onclick="callTaxi(0,0,'City Center')">City Center</button>
 <button onclick="callTaxi(35,35,'Shopping Mall')">Shopping Mall</button>
 <button onclick="callTaxi(-35,35,'Hospital')">Hospital</button>
 <button onclick="callTaxi(35,-35,'Police Station')">Police Station</button>
 <p>Estimated fare: ₹200</p>`);
}
function callTaxi(x,z,name){
 if(game.money<200){toast("Insufficient balance");return}
 game.money-=200;closePanel();
 toast("Taxi is coming...");
 const taxi=createCarMesh(0xffcc22);
 taxi.position.set(player.position.x+12,.2,player.position.z+10);
 scene.add(taxi);
 let timer=0;
 const interval=setInterval(()=>{
  timer++;
  taxi.position.lerp(player.position,.12);
  if(timer>30){
   clearInterval(interval);
   toast("Taxi arrived. Boarding...");
   player.position.copy(taxi.position);
   game.inCar=true;game.car=taxi;game.carName="Taxi";
   game.car.userData.speed=.12;
   setTimeout(()=>{
    const start=taxi.position.clone();
    let step=0;
    const journey=setInterval(()=>{
     step++;
     taxi.position.lerp(new THREE.Vector3(x,.2,z),.025);
     player.position.copy(taxi.position);
     if(step>100){
      clearInterval(journey);
      game.inCar=false;game.car=null;
      player.position.set(x,0,z);
      scene.remove(taxi);
      toast("Reached "+name);
      updateHUD();
     }
    },50);
   },1500);
  }
 },100);
}

