function startJob(name){
 if(game.jobBusy){toast("A job is already active");return}
 const job=jobTypes.find(j=>j.name===name);
 if(!job)return;
 game.jobBusy=true;game.job=name;
 closePanel();
 toast(name+" started. Complete your task!");
 setTimeout(()=>{
  if(!game.jobBusy)return;
  game.money+=job.pay;
  game.jobBusy=false;game.job=null;
  toast("Job completed! +₹"+job.pay);
  updateHUD();
 },20000);
}

