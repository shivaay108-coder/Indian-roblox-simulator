}
function updateJob(){
 $("jobStatus").textContent=currentJob?
 "Job: "+currentJob.type+" | "+currentJob.stage:"Job: None";
}
function busStopAction(){
 if(!currentJob||currentJob.type!=="bus"||!activeVehicle||activeVehicle.type!=="bus")return;
 if(currentJob.stage==="pickup"){
  if(busPassengers>=10)return toast("Bus is full");
  const count=Math.min(3,10-busPassengers);
  busPassengers+=count;
  currentJob.stage="pickup";
  busStopIndex++;
  if(busStopIndex<busStops.length){
   setGPS(busStops[busStopIndex]);
   toast(count+" students boarded. Passengers: "+busPassengers);
  }else{
   currentJob.stage="drop";
   setGPS(currentJob.destination);
   toast("All pickup stops completed. Go to School.");
  }
 }else if(currentJob.stage==="drop"){
  busPassengers=0;
  cash+=currentJob.reward;
  currentJob=null;clearRoute();updateJob();updateHUD();save();
  toast("School Bus job completed! +₹1200");
 }
}
function completeSimpleJob(){
 if(!currentJob)return;
 cash+=currentJob.reward;currentJob=null;clearRoute();
 updateJob();updateHUD();save();toast("Job completed! Reward added.");
}

