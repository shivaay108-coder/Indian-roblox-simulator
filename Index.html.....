
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Indian Roblox Life Simulator - Prototype 5</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#111827;font-family:Arial;color:white;touch-action:none}
#game{position:fixed;inset:0}
canvas{display:block}
button,input,select{font:inherit}
button{border:0;border-radius:10px;padding:10px 13px;background:#263b58;color:white;font-weight:bold}
button:active{transform:scale(.96);background:#087cba}
#hud{position:fixed;inset:0;pointer-events:none}
.panel{background:#101b2ddd;border:1px solid #52708c;border-radius:12px;padding:9px;box-shadow:0 3px 15px #0007}
#top{position:absolute;top:8px;left:8px;right:8px;display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
#stats{font-size:12px;line-height:1.6}
#miniWrap{pointer-events:auto;width:122px;height:122px;position:relative}
#mini{width:122px;height:122px;border-radius:12px;background:#15283a}
#miniLabel{position:absolute;top:3px;left:6px;font-size:10px;text-shadow:0 1px 3px black}
#location{position:absolute;top:140px;left:8px;font-size:12px}
#jobStatus{position:absolute;top:174px;left:8px;font-size:12px;max-width:190px}
#speed{position:absolute;right:12px;bottom:145px;font-size:17px;text-align:right}
#phoneBtn{pointer-events:auto;position:absolute;right:12px;top:145px;background:#7b35c9;border:1px solid #d5a7ff}
#interact{pointer-events:auto;position:absolute;right:16px;bottom:80px;background:#0d789f}
#jump{pointer-events:auto;position:absolute;right:16px;bottom:20px}
#run{pointer-events:auto;position:absolute;right:90px;bottom:20px}
#exitBtn{pointer-events:auto;position:absolute;right:90px;bottom:80px;display:none;background:#9a4a24}
#joystick{pointer-events:auto;position:absolute;left:18px;bottom:25px;width:120px;height:120px;border-radius:50%;background:#b8d6ef22;border:2px solid #b8d6ef77}
#stick{position:absolute;left:35px;top:35px;width:46px;height:46px;border-radius:50%;background:#d4edff99;border:2px solid white}
#cameraArea{position:absolute;right:0;bottom:0;width:60%;height:60%;pointer-events:auto}
#landscape{position:fixed;inset:0;background:#07111f;z-index:99;display:none;align-items:center;justify-content:center;text-align:center;padding:25px}
#phone,#worldMap,#dialog{position:fixed;z-index:20;inset:3%;display:none;background:#111a2c;border:2px solid #9a68d8;border-radius:22px;padding:14px;overflow:auto;box-shadow:0 0 35px #000b}
#phone{background:linear-gradient(145deg,#26133e,#101d39);border-color:#b57aff}
#phoneHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
#phoneTitle{font-size:20px;font-weight:bold;color:#e6caff}
#appGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.appIcon{min-height:82px;background:#ffffff12;border:1px solid #ffffff25;border-radius:15px;text-align:center;padding:10px 3px;color:white}
.appIcon .emoji{font-size:28px;display:block;margin-bottom:6px}
.appIcon small{font-size:11px}
#appPage{margin-top:12px;background:#0a1428;border-radius:14px;padding:12px;min-height:180px}
#appPage button{margin:4px}
#appPage input,#appPage select{max-width:100%;padding:9px;border-radius:8px;border:1px solid #66809c;background:#17263d;color:white;margin:4px}
#worldMap{background:#0a1726;border-color:#50caff}
#worldCanvas{width:100%;height:70%;background:#172b3c;border-radius:12px;touch-action:none}
#mapTools{display:flex;gap:7px;flex-wrap:wrap;margin:8px 0}
#dialog{inset:20% 8%;z-index:30;max-height:60%;border-color:#4ccaff}
#toast{position:fixed;z-index:50;left:50%;top:45%;transform:translate(-50%,-50%);background:#101b2e;border:1px solid #66cfff;border-radius:12px;padding:12px 18px;display:none;pointer-events:none;text-align:center}
#phoneClose,#mapClose{background:#943e55}
#help{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:12px;color:#ffffffaa;text-align:center;pointer-events:none}
@media(orientation:portrait){
#landscape{display:flex}
}
</style>
</head>
<body>
<div id="game"></div>

<div id="hud">
 <div id="top">
  <div class="panel" id="stats">
   <b>INDIAN LIFE SIMULATOR</b><br>
   Cash: ₹<span id="cash">2500</span><br>
   Bank: ₹<span id="bank">5000</span><br>
   <span id="health">Health: 100</span>
  </div>
  <div id="miniWrap" class="panel">
   <span id="miniLabel">MINI MAP · 20m</span>
   <canvas id="mini" width="244" height="244"></canvas>
  </div>
 </div>
 <div id="location" class="panel">Location: Home</div>
 <div id="jobStatus" class="panel">Job: None</div>
 <button id="phoneBtn">📱 PHONE</button>
 <div id="speed" class="panel">0 km/h</div>
 <button id="interact">ENTER / ACTION</button>
 <button id="exitBtn">EXIT</button>
 <button id="run">RUN</button>
 <button id="jump">JUMP</button>
 <div id="joystick"><div id="stick"></div></div>
 <div id="cameraArea"></div>
</div>

<div id="phone">
 <div id="phoneHead">
  <div><div id="phoneTitle">📱 My Phone</div><small id="phoneClock">Indian Life OS</small></div>
  <button id="phoneClose">✕ CLOSE</button>
 </div>
 <div id="appGrid"></div>
 <div id="appPage">Welcome! Select an app.</div>
</div>

<div id="worldMap">
 <div style="display:flex;justify-content:space-between;align-items:center">
  <b>🗺️ WORLD MAP & GPS</b><button id="mapClose">CLOSE</button>
 </div>
 <div id="mapTools">
  <button id="zoomIn">＋ Zoom</button>
  <button id="zoomOut">－ Zoom</button>
  <button id="mapCenter">My Location</button>
  <span id="selectedPlace">Destination: None</span>
 </div>
 <canvas id="worldCanvas" width="900" height="550"></canvas>
 <button id="setDestination">SET GPS DESTINATION</button>
</div>

<div id="dialog">
 <div id="dialogContent"></div>
 <button onclick="closeDialog()">CLOSE</button>
</div>
<div id="toast"></div>
<div id="landscape">📱<br><br>Please rotate your phone to Landscape Mode<br><br>गेम खेलने के लिए फोन Horizontal करें।</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js"></script>
<script>
"use strict";

/* =========================
   1. GAME DATA
========================= */
const $=id=>document.getElementById(id);
const places=[
 ["Home",-20,10],["School",85,85],["Bank",-90,40],
 ["Hospital",95,-65],["Shopping Mall",10,-100],
 ["Petrol Pump",-110,-70],["Garage",0,105],
 ["Office",100,0],["Restaurant",-65,-105],
 ["Bus Station",130,80],["Taxi Stand",-135,95],
 ["Park",20,65],["Home Stop",-30,20],
 ["Market Stop",15,-80],["Park Stop",30,70]
];
const appList=[
 ["App Store","🛍️","store"],["Play Store","▶️","play"],
 ["Bank","🏦","bank"],["Shopping","🛒","shop"],
 ["Map / GPS","🗺️","map"],["Taxi","🚕","taxi"],
 ["Jobs","💼","jobs"],["Garage","🔧","garage"],
 ["Restaurant","🍔","food"],["Car Rental","🚘","rental"],
 ["Inventory","🎒","inventory"]
];
let installed=new Set(["store","play","map","jobs"]);
let cash=2500,bank=5000,health=100;
let inventory={Water:2,Food:1};
let selectedDestination=null;
let currentJob=null;
let busStops=[],busStopIndex=0,busPassengers=0;
let activeVehicle=null,vehicles=[],npcs=[],foodOrders=[];
let taxi=null,taxiPhase="",rentalCars=0;
let playerYaw=0,camYaw=0,camPitch=.32,camDistance=9;
let moving=false,running=false,jumpTime=0;
let joy={x:0,y:0},keys={};
let mapZoom=1,mapCenter={x:0,z:0};
let lastTime=0,phoneOpen=false,driving=false;
let renderer,scene,camera,player,playerRig,routeLine;
let carShopPrice=6500;
let gameReady=false;

/* =========================
   2. THREE.JS WORLD
========================= */
const container=$("game");
scene=new THREE.Scene();
scene.background=new THREE.Color(0x8cc7ed);
scene.fog=new THREE.Fog(0x8cc7ed,180,520);
camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,900);
renderer=new THREE.WebGLRenderer({antialias:false,powerPreference:"high-performance"});
renderer.setSize(innerWidth,innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
renderer.shadowMap.enabled=false;
container.appendChild(renderer.domElement);

scene.add(new THREE.HemisphereLight(0xffffff,0x61735d,2));
const sun=new THREE.DirectionalLight(0xffffff,2);
sun.position.set(-100,180,100);
scene.add(sun);

const mat=(color,rough=.85)=>new THREE.MeshStandardMaterial({color,roughness:rough});
const materials={
 grass:mat(0x6d9e58),road:mat(0x303943),line:mat(0xe9e4c6),
 skin:mat(0xffc18d),shirt:mat(0x2479d5),pants:mat(0x293a67),
 hair:mat(0x252020),glass:mat(0x78b8d0,.3),
 building:mat(0xd3b98e),white:mat(0xf0eee5),
 red:mat(0xd74c40),blue:mat(0x287fc0),yellow:mat(0xf0bd34)
};

function box(w,h,d,material,x,y,z,parent=scene){
 const m=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);
 m.position.set(x,y,z);parent.add(m);return m;
}
function ground(){
 box(700,.2,700,materials.grass,0,-.15,0);
 for(let i=-300;i<=300;i+=50){
  box(12,.04,700,materials.road,i,.01,0);
  box(700,.04,12,materials.road,0,.02,i);
  for(let j=-300;j<300;j+=25){
   box(0.5,.05,7,materials.line,i,.05,j);
   box(7,.05,.5,materials.line,j,.05,i);
  }
 }
}
ground();

function makeBuilding(name,x,z,color=0xd3b98e,w=22,h=13,d=18){
 const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
 box(w,h,d,mat(color),0,h/2,0,g);
 box(w+1,1,d+1,mat(0x4c5360),0,h,0,g);
 // Front windows
 for(let xx=-w/2+3;xx<w/2-1;xx+=5){
  box(2.2,3,.15,materials.glass,xx,h*.65,d/2+.09,g);
 }
 box(4,5,.25,mat(0x63452f),0,2.5,d/2+.13,g);
 const sign=box(Math.min(w-2,15),1.5,.3,mat(color===0xd3b98e?0x244c77:0x264a60),0,h+1,d/2+.2,g);
 sign.userData.label=name;
 return g;
}
const buildings=[];
const buildingData=[
 ["HOME",-20,10,0xd8b58b],["SCHOOL",85,85,0xe3c66d],
 ["BANK",-90,40,0x8cacc9],["HOSPITAL",95,-65,0xf0eeee],
 ["MALL",10,-100,0xb6a0d5],["PETROL",-110,-70,0x6da9b8],
 ["GARAGE",0,105,0x8a9ba6],["OFFICE",100,0,0x9cabc1],
 ["DHABA",-65,-105,0xc68a52],["BUS STATION",130,80,0x8db2a0],
 ["TAXI STAND",-135,95,0xe6ce63],["PARK",20,65,0x6ca16a]
];
for(const b of buildingData){
 const g=makeBuilding(...b);
 buildings.push({x:b[1],z:b[2],w:22,d:18,name:b[0],group:g});
}
// Open front garage: add roof and side supports, no front door
const garage=buildings.find(b=>b.name==="GARAGE");
if(garage){
 garage.group.children[0].visible=false;
 box(26,1,23,mat(0x697b8a),0,12,0,garage.group);
 box(1,12,1,mat(0x596a78),-12,6,0,garage.group);
 box(1,12,1,mat(0x596a78),12,6,0,garage.group);
}
function makeTree(x,z){
 const g=new THREE.Group();g.position.set(x,0,z);scene.add(g);
 box(.8,5,.8,mat(0x74502d),0,2.5,0,g);
 const crown=new THREE.Mesh(new THREE.SphereGeometry(3,7,6),mat(0x2c7d48));
 crown.position.y=6;g.add(crown);
}
for(let i=0;i<65;i++){
 let x=(Math.random()-.5)*520,z=(Math.random()-.5)*520;
 if(Math.abs(x%50)<13||Math.abs(z%50)<13)continue;
 makeTree(x,z);
}

/* =========================
   3. ROBLOX PLAYER
========================= */
function limb(w,h,d,material,x,y,z,parent){
 return box(w,h,d,material,x,y,z,parent);
}
function makeCharacter(shirt=materials.shirt){
 const root=new THREE.Group();
 const torso=limb(1.2,1.5,.65,shirt,0,2.25,0,root);
 const head=limb(.85,.85,.85,materials.skin,0,3.45,0,root);
 limb(.9,.25,.9,materials.hair,0,3.91,0,root);
 // Face points toward local -Z
 limb(.12,.12,.04,mat(0x202020),-.2,3.5,-.44,root);
 limb(.12,.12,.04,mat(0x202020),.2,3.5,-.44,root);
 limb(.3,.06,.04,mat(0x8b3030),0,3.25,-.45,root);
 const leftArm=limb(.35,1.3,.4,materials.skin,-.85,2.25,0,root);
 const rightArm=limb(.35,1.3,.4,materials.skin,.85,2.25,0,root);
 const leftLeg=limb(.45,1.25,.5,materials.pants,-.32,.65,0,root);
 const rightLeg=limb(.45,1.25,.5,materials.pants,.32,.65,0,root);
 root.userData={leftArm,rightArm,leftLeg,rightLeg,head,torso};
 scene.add(root);return root;
}
player=makeCharacter();
player.position.set(-20,0,18);
playerRig=player;

function animateRig(root,t,walk,speed=1){
 if(!root||!root.userData.leftArm)return;
 const a=Math.sin(t*9)*.55*walk*speed;
 root.userData.leftArm.rotation.x=a;
 root.userData.rightArm.rotation.x=-a;
 root.userData.leftLeg.rotation.x=-a;
 root.userData.rightLeg.rotation.x=a;
}
function playerPosition(){return activeVehicle?activeVehicle.root.position:player.position}
function nearestPlace(){
 const p=playerPosition();let best=null,dist=1e9;
 for(const a of places){
  const d=Math.hypot(p.x-a[1],p.z-a[2]);
  if(d<dist){dist=d;best=a}
 }
 return {place:best,distance:dist};
}

/* =========================
   4. VEHICLES
========================= */
function makeVehicle(type,x,z,color=0x287fc0){
 const root=new THREE.Group();root.position.set(x,0,z);scene.add(root);
 const body=box(type==="bus"?3.6:2.2,type==="bus"?1.5:.8,type==="bus"?7:4,mat(color),0,1.1,0,root);
 box(type==="bus"?3.3:1.9,type==="bus"?1.1:.9,type==="bus"?3.5:2,materials.glass,0,2,0,root);
 const wheels=[];
 for(const xx of [-1.2,1.2])for(const zz of type==="bus"?[-2.5,2.5]:[-1.3,1.3]){
  const wheel=new THREE.Mesh(new THREE.CylinderGeometry(.42,.42,.25,10),mat(0x17191c));
  wheel.rotation.z=Math.PI/2;wheel.position.set(xx,.5,zz);root.add(wheel);wheels.push(wheel);
 }
 const v={root,type,wheels,speed:0,yaw:0,color,health:100};
 vehicles.push(v);return v;
}
const starterCar=makeVehicle("car",-12,22,0x176dc4);
function enterVehicle(v){
 if(!v)return;
 activeVehicle=v;driving=true;
 player.visible=false;
 $("exitBtn").style.display="block";
 toast("Entered "+v.type.toUpperCase());
}
function exitVehicle(){
 if(!activeVehicle)return;
 const p=activeVehicle.root.position;
 player.position.set(p.x+3,0,p.z+2);
 player.visible=true;activeVehicle=null;driving=false;
 $("exitBtn").style.display="none";
}
$("exitBtn").onclick=exitVehicle;
function updateVehicle(v,dt){
 if(v===activeVehicle){
  const throttle=(keys.w?1:0)-(keys.s?1:0)-joy.y;
  const steer=(keys.d?1:0)-(keys.a?1:0)+joy.x;
  v.speed+=(throttle*23-v.speed*1.4)*dt;
  v.speed=THREE.MathUtils.clamp(v.speed,-12,25);
  v.yaw+=steer*dt*(.9+Math.abs(v.speed)*.04);
  v.root.rotation.y=v.yaw;
  v.root.position.x-=Math.sin(v.yaw)*v.speed*dt;
  v.root.position.z-=Math.cos(v.yaw)*v.speed*dt;
  if(Math.abs(v.speed)<.2)v.speed=0;
 }else v.speed*=.98;
 v.wheels.forEach(w=>w.rotation.x+=v.speed*dt*1.5);
}
function nearestVehicle(){
 const p=playerPosition();let best=null,distance=8;
 for(const v of vehicles){
  const d=p.distanceTo(v.root.position);
  if(d<distance){best=v;distance=d}
 }
 return best;
}

/* =========================
   5. NPCs
========================= */
function spawnNPC(x,z){
 const n=makeCharacter(mat([0x36a6a2,0xb76b9c,0xdaa94e,0x6b8bd4][Math.floor(Math.random()*4)]));
 n.position.set(x,0,z);
 n.userData.target=new THREE.Vector3(x+(Math.random()-.5)*30,0,z+(Math.random()-.5)*30);
 npcs.push(n);
}
for(let i=0;i<14;i++)spawnNPC((Math.random()-.5)*180,(Math.random()-.5)*180);
function updateNPCs(dt,t){
 for(const n of npcs){
  const target=n.userData.target;
  const dx=target.x-n.position.x,dz=target.z-n.position.z;
  const d=Math.hypot(dx,dz);
  if(d<2)n.userData.target.set(n.position.x+(Math.random()-.5)*35,0,n.position.z+(Math.random()-.5)*35);
  else{
   n.position.x+=dx/d*dt*2;
   n.position.z+=dz/d*dt*2;
   n.rotation.y=Math.atan2(-dx,-dz);
  }
  animateRig(n,t,1,.5);
 }
}

/* =========================
   6. GPS ROUTE
========================= */
function clearRoute(){
 if(routeLine){scene.remove(routeLine);routeLine.geometry.dispose();routeLine=null}
}
function setGPS(place){
 selectedDestination=place;
 clearRoute();
 if(!place){toast("GPS cleared");return}
 const p=playerPosition();
 const points=[new THREE.Vector3(p.x,.35,p.z),new THREE.Vector3(place[1],.35,place[2])];
 routeLine=new THREE.Line(new THREE.BufferGeometry().setFromPoints(points),
  new THREE.LineBasicMaterial({color:0x00eaff}));
 scene.add(routeLine);
 toast("GPS set: "+place[0]);
 $("selectedPlace").textContent="Destination: "+place[0];
}
function routeWaypoints(a,b){
 // Simple grid-road route approximation
 const pts=[new THREE.Vector3(a.x,.4,a.z)];
 const midX=Math.round(b.x/50)*50;
 pts.push(new THREE.Vector3(midX,.4,a.z));
 pts.push(new THREE.Vector3(midX,.4,b.z));
 pts.push(new THREE.Vector3(b.x,.4,b.z));
 return pts;
}

/* =========================
   7. PHONE SYSTEM
========================= */
function openPhone(){
 phoneOpen=true;$("phone").style.display="block";
 renderPhone();$("appPage").innerHTML="Choose an app from your phone.";
}
function closePhone(){phoneOpen=false;$("phone").style.display="none"}
$("phoneBtn").onclick=openPhone;
$("phoneClose").onclick=closePhone;

function renderPhone(){
 const grid=$("appGrid");grid.innerHTML="";
 for(const a of appList){
  const installedApp=installed.has(a[2]);
  const div=document.createElement("button");
  div.className="appIcon";
  div.innerHTML='<span class="emoji">'+a[1]+'</span><small>'+a[0]+'</small><br><small>'+(installedApp?"OPEN":"INSTALL")+'</small>';
  div.onclick=()=>openApp(a[2]);
  grid.appendChild(div);
 }
}
function appButton(label,fn){
 const b=document.createElement("button");b.textContent=label;b.onclick=fn;return b;
}
function appPage(title,html){
 $("appPage").innerHTML="<h3>"+title+"</h3>"+html;
}
function openApp(id){
 if(!installed.has(id)&&id!=="store"&&id!=="play"){
  appPage("Install App",'<p>This app is not installed.</p>');
  $("appPage").appendChild(appButton("INSTALL",()=>{installed.add(id);save();renderPhone();openApp(id);toast("App installed")}));
  return;
 }
 switch(id){
  case "store":case "play":showStore(id);break;
  case "bank":showBank();break;
  case "shop":showShopping();break;
  case "map":closePhone();openWorldMap();break;
  case "taxi":showTaxi();break;
  case "jobs":showJobs();break;
  case "garage":showGarage();break;
  case "food":showRestaurant();break;
  case "rental":showRental();break;
  case "inventory":showInventory();break;
 }
}
function showStore(id){
 let html="<p>Download in-game apps. These are game apps, not real phone installations.</p>";
 for(const a of appList){
  if(["store","play"].includes(a[2]))continue;
  html+='<p>'+a[1]+' <b>'+a[0]+'</b> — '+(installed.has(a[2])?"Installed":'<button onclick="installApp(\\''+a[2]+'\\')">Install</button>')+'</p>';
 }
 appPage(id==="store"?"App Store":"Play Store",html);
}
function installApp(id){
 installed.add(id);save();renderPhone();toast("App installed successfully");
 showStore("store");
}

/* =========================
   8. BANK AND SHOPPING
========================= */
function showBank(){
 appPage("🏦 Bank",
 '<p>Cash Wallet: ₹'+cash+'</p><p>Bank Balance: ₹'+bank+'</p>'+
 '<input id="bankAmount" type="number" min="1" placeholder="Amount">'+
 '<button onclick="bankAction(\\'deposit\\')">Deposit</button>'+
 '<button onclick="bankAction(\\'withdraw\\')">Withdraw</button>'+
 '<p id="bankMessage">Secure in-game bank account.</p>');
}
function bankAction(type){
 const amount=Math.floor(Number($("bankAmount").value));
 if(!amount||amount<1){toast("Enter valid amount");return}
 if(type==="deposit"&&cash>=amount){cash-=amount;bank+=amount}
 else if(type==="withdraw"&&bank>=amount){bank-=amount;cash+=amount}
 else{toast("Insufficient balance");return}
 save();updateHUD();showBank();toast("Transaction completed");
}
const shopItems=[
 ["Water",50],["Food",100],["Med Kit",250],["Phone Cover",150],
 ["School Bag",300],["Sports Shoes",500]
];
function showShopping(){
 let html="<p>Available Items</p>";
 shopItems.forEach((it,i)=>html+='<p>'+it[0]+' — ₹'+it[1]+' <button onclick="buyItem('+i+')">BUY</button></p>');
 appPage("🛒 Shopping",html);
}
function buyItem(i){
 const it=shopItems[i];
 if(cash<it[1])return toast("Not enough cash");
 cash-=it[1];inventory[it[0]]=(inventory[it[0]]||0)+1;
 save();updateHUD();showShopping();toast(it[0]+" purchased");
}

