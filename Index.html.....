========================= */
function showTaxi(){
 let html='<p>Choose your destination:</p><select id="taxiDest">';
 places.forEach((p,i)=>html+='<option value="'+i+'">'+p[0]+'</option>');
 html+='</select><p>Taxi fare: ₹150 base + distance</p><button onclick="bookTaxi()">BOOK TAXI</button>';
 appPage("🚕 Taxi Booking",html);
}
function bookTaxi(){
 if(taxi)return toast("A taxi booking is already active");
 const place=places[Number($("taxiDest").value)];
 if(!place)return;
 const p=playerPosition();
 const fare=Math.ceil(150+Math.hypot(place[1]-p.x,place[2]-p.z)*2);
 if(cash<fare)return toast("Not enough cash for taxi");
 taxi=makeVehicle("taxi",p.x+25,p.z+25,0xf1c63c);
 taxi.target={x:p.x,z:p.z};taxi.destination=place;taxi.fare=fare;
 taxiPhase="coming";toast("Taxi booked! It is coming.");
 $("appPage").innerHTML="<h3>Taxi Booked</h3><p>Taxi is coming to your location.</p><button onclick='enterTaxi()'>ENTER TAXI (when arrived)</button>";
}
function updateTaxi(dt){
 if(!taxi)return;
 if(taxiPhase==="coming"){
  const p=playerPosition();
  moveToward(taxi,p.x+3,p.z+3,dt,12);
  if(Math.hypot(taxi.root.position.x-p.x,taxi.root.position.z-p.z)<5){
   taxiPhase="arrived";toast("Taxi arrived. Press ENTER TAXI.");
  }
 }
 if(taxiPhase==="riding"){
  const d=taxi.destination;
  moveToward(taxi,d[1],d[2],dt,16);
  if(Math.hypot(taxi.root.position.x-d[1],taxi.root.position.z-d[2])<3){
   cash-=taxi.fare;taxi.root.position.set(d[1],0,d[2]);
   if(activeVehicle===taxi){activeVehicle=null;driving=false;player.visible=true}
   scene.remove(taxi.root);vehicles=vehicles.filter(v=>v!==taxi);
   taxi=null;taxiPhase="";$("exitBtn").style.display="none";
   updateHUD();save();toast("Taxi ride completed!");
  }
 }
}
function moveToward(v,x,z,dt,speed){
 const dx=x-v.root.position.x,dz=z-v.root.position.z;
 const d=Math.hypot(dx,dz);
 if(d>.5){
  v.root.position.x+=dx/d*speed*dt;
  v.root.position.z+=dz/d*speed*dt;
  v.root.rotation.y=Math.atan2(-dx,-dz);
  v.wheels.forEach(w=>w.rotation.x+=dt*speed);
 }
}
function enterTaxi(){
 if(!taxi||taxiPhase!=="arrived")return toast("Taxi has not arrived");
 enterVehicle(taxi);taxiPhase="riding";toast("Taxi ride started");
}

