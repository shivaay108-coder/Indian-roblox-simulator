/* =========================
   13. WORLD MAP
========================= */
const worldCanvas=$("worldCanvas"),wctx=worldCanvas.getContext("2d");
function drawWorldMap(){
 const w=worldCanvas.width,h=worldCanvas.height;
 wctx.clearRect(0,0,w,h);wctx.fillStyle="#172b3c";wctx.fillRect(0,0,w,h);
 const scale=mapZoom*1.3;
 const sx=x=>w/2+(x-mapCenter.x)*scale;
 const sy=z=>h/2+(z-mapCenter.z)*scale;
 wctx.strokeStyle="#687b87";wctx.lineWidth=8*scale/1.3;
 for(let i=-300;i<=300;i+=50){
  wctx.beginPath();wctx.moveTo(sx(i),0);wctx.lineTo(sx(i),h);wctx.stroke();
  wctx.beginPath();wctx.moveTo(0,sy(i));wctx.lineTo(w,sy(i));wctx.stroke();
 }
 for(const p of places){
  const x=sx(p[1]),y=sy(p[2]);
  if(x<0||x>w||y<0||y>h)continue;
  wctx.fillStyle="#f0cb57";wctx.beginPath();wctx.arc(x,y,6,0,7);wctx.fill();
  wctx.fillStyle="white";wctx.font="14px Arial";wctx.fillText(p[0],x+8,y-8);
 }
 const pos=playerPosition();
 wctx.save();wctx.translate(sx(pos.x),sy(pos.z));wctx.rotate(playerYaw);
 wctx.fillStyle="#28dfff";wctx.beginPath();
 wctx.moveTo(0,-12);wctx.lineTo(-8,9);wctx.lineTo(8,9);wctx.closePath();wctx.fill();
 wctx.restore();
 if(selectedDestination){
  wctx.strokeStyle="#00eaff";wctx.lineWidth=3;
  wctx.beginPath();wctx.moveTo(sx(pos.x),sy(pos.z));
  wctx.lineTo(sx(selectedDestination[1]),sy(selectedDestination[2]));wctx.stroke();
 }
}
function openWorldMap(){
 $("worldMap").style.display="block";
 mapCenter={x:playerPosition().x,z:playerPosition().z};
 drawWorldMap();
}
$("mapClose").onclick=()=>$("worldMap").style.display="none";
$("zoomIn").onclick=()=>{mapZoom=Math.min(4,mapZoom*1.25);drawWorldMap()};
$("zoomOut").onclick=()=>{mapZoom=Math.max(.4,mapZoom/1.25);drawWorldMap()};
$("mapCenter").onclick=()=>{mapCenter={x:playerPosition().x,z:playerPosition().z};drawWorldMap()};
worldCanvas.addEventListener("click",e=>{
 const r=worldCanvas.getBoundingClientRect();
 const x=(e.clientX-r.left-r.width/2)/r.width*worldCanvas.width;
 const y=(e.clientY-r.top-r.height/2)/r.height*worldCanvas.height;
 const wx=x/(mapZoom*1.3)+mapCenter.x;
 const wz=y/(mapZoom*1.3)+mapCenter.z;
 let best=null,dist=1e9;
 for(const p of places){
  const d=Math.hypot(p[1]-wx,p[2]-wz);
  if(d<dist){best=p;dist=d}
 }
 if(best&&dist<25){
  selectedDestination=best;
  $("selectedPlace").textContent="Destination: "+best[0];
  drawWorldMap();toast("Selected "+best[0]);
 }
});
$("setDestination").onclick=()=>{
 if(!selectedDestination)return toast("Select a location first");
 setGPS(selectedDestination);$("worldMap").style.display="none";
};

/* =========================
   14. MINI MAP WITH DIRECTION TRIANGLE
========================= */
function drawMini(){
 const c=$("mini"),ctx=c.getContext("2d"),s=c.width;
 ctx.clearRect(0,0,s,s);ctx.fillStyle="#182b3b";ctx.fillRect(0,0,s,s);
 // 20 metres in all four directions
 const range=20,scale=s/(range*2);
 const p=playerPosition();
 const X=x=>s/2+(x-p.x)*scale;
 const Y=z=>s/2+(z-p.z)*scale;
 ctx.strokeStyle="#667783";ctx.lineWidth=5;
 for(let i=-300;i<=300;i+=50){
  ctx.beginPath();ctx.moveTo(X(i),0);ctx.lineTo(X(i),s);ctx.stroke();
  ctx.beginPath();ctx.moveTo(0,Y(i));ctx.lineTo(s,Y(i));ctx.stroke();
 }
 for(const place of places){
  const x=X(place[1]),y=Y(place[2]);
  if(x<0||x>s||y<0||y>s)continue;
  ctx.fillStyle="#e8c34b";ctx.fillRect(x-3,y-3,6,6);
 }
 // GPS line
 if(selectedDestination){
  ctx.strokeStyle="#00eaff";ctx.lineWidth=3;
  ctx.beginPath();ctx.moveTo(s/2,s/2);
  ctx.lineTo(X(selectedDestination[1]),Y(selectedDestination[2]));ctx.stroke();
 }
 // Direction triangle: pointed end is player's face direction
 ctx.save();ctx.translate(s/2,s/2);ctx.rotate(playerYaw);
 ctx.fillStyle="#31e7ff";ctx.strokeStyle="white";ctx.lineWidth=2;
 ctx.beginPath();ctx.moveTo(0,-13);ctx.lineTo(-9,10);ctx.lineTo(9,10);
 ctx.closePath();ctx.fill();ctx.stroke();ctx.restore();
}
$("mini").addEventListener("click",openWorldMap);

/* =========================
   15. INTERACTION
========================= */
function interact(){
 if(driving){
  if(activeVehicle&&activeVehicle.type==="bus")busStopAction();
  else if(currentJob&&currentJob.type==="taxiDriver")completeSimpleJob();
  return;
 }
 const near=nearestVehicle();
 if(near){enterVehicle(near);return}
 const n=nearestPlace();
 if(n.distance<18){
  const name=n.place[0];
  if(name==="Garage")openPhoneWithApp("garage");
  else if(name==="Bank")openPhoneWithApp("bank");
  else if(name==="Restaurant")openPhoneWithApp("food");
  else if(name==="School"&&currentJob?.type==="bus")busStopAction();
  else toast("You are near "+name);
 }else toast("No vehicle or location nearby");
}
function openPhoneWithApp(id){openPhone();openApp(id)}
$("interact").onclick=interact;
$("jump").onclick=()=>{if(!driving&&jumpTime<=0)jumpTime=.55};
$("run").onpointerdown=()=>running=true;
$("run").onpointerup=()=>running=false;
$("run").onpointerleave=()=>running=false;

/* =========================
   16. JOYSTICK / CAMERA
========================= */
const joyBase=$("joystick"),stick=$("stick");
let joyPointer=null;
joyBase.addEventListener("pointerdown",e=>{
 joyPointer=e.pointerId;joyBase.setPointerCapture(e.pointerId);moveJoy(e);
});
joyBase.addEventListener("pointermove",e=>{if(e.pointerId===joyPointer)moveJoy(e)});
function moveJoy(e){
 const r=joyBase.getBoundingClientRect();
 let dx=e.clientX-(r.left+r.width/2),dy=e.clientY-(r.top+r.height/2);
 const len=Math.hypot(dx,dy),max=42;
 if(len>max){dx=dx/len*max;dy=dy/len*max}
 joy.x=dx/max;joy.y=dy/max;
 stick.style.left=(35+dx)+"px";stick.style.top=(35+dy)+"px";
}
function resetJoy(){
 joyPointer=null;joy.x=0;joy.y=0;stick.style.left="35px";stick.style.top="35px";
}
joyBase.addEventListener("pointerup",resetJoy);
joyBase.addEventListener("pointercancel",resetJoy);
let camPointer=null,lastCamX=0,lastCamY=0;
$("cameraArea").addEventListener("pointerdown",e=>{
 camPointer=e.pointerId;lastCamX=e.clientX;lastCamY=e.clientY;
 $("cameraArea").setPointerCapture(e.pointerId);
});
$("cameraArea").addEventListener("pointermove",e=>{
 if(e.pointerId!==camPointer)return;
 camYaw-=(e.clientX-lastCamX)*.008;
 camPitch=THREE.MathUtils.clamp(camPitch+(e.clientY-lastCamY)*.006,-.15,1.05);
 lastCamX=e.clientX;lastCamY=e.clientY;
});
$("cameraArea").addEventListener("pointerup",()=>camPointer=null);
$("cameraArea").addEventListener("pointercancel",()=>camPointer=null);
addEventListener("keydown",e=>{
 keys[e.key.toLowerCase()]=true;
 if(e.key===" "&&!driving)jumpTime=.55;
});
addEventListener("keyup",e=>keys[e.key.toLowerCase()]=false);
addEventListener("wheel",e=>{
 camDistance=THREE.MathUtils.clamp(camDistance+e.deltaY*.01,4,18);
},{passive:true});

/* =========================
   17. PLAYER UPDATE / CAMERA
========================= */
function updatePlayer(dt,t){
 if(driving||phoneOpen||$("worldMap").style.display==="block")return;
 const forward=-(keys.w?1:0)-(joy.y);
 const side=(keys.d?1:0)-(keys.a?1:0)+joy.x;
 const f=THREE.MathUtils.clamp(forward,-1,1);
 const s=THREE.MathUtils.clamp(side,-1,1);
 const speed=running?9:5;
 const dx=(-Math.sin(camYaw)*f+Math.cos(camYaw)*s)*speed*dt;
 const dz=(-Math.cos(camYaw)*f-Math.sin(camYaw)*s)*speed*dt;
 player.position.x+=dx;player.position.z+=dz;
 moving=Math.abs(f)+Math.abs(s)>.1;
 if(moving){
  playerYaw=Math.atan2(-dx,-dz);
  player.rotation.y=playerYaw;
 }
 if(jumpTime>0){
  jumpTime-=dt;
  player.position.y=Math.sin((.55-jumpTime)/.55*Math.PI)*1.8;
 }else player.position.y=0;
 animateRig(player,t,moving?1:0,running?1.5:1);
}
function updateCamera(){
 const target=playerPosition().clone();
 target.y+=driving?2.1:2.6;
 const distance=driving?camDistance+2:camDistance;
 const x=target.x+Math.sin(camYaw)*Math.cos(camPitch)*distance;
 const y=target.y+Math.sin(camPitch)*distance+1.2;
 const z=target.z+Math.cos(camYaw)*Math.cos(camPitch)*distance;
 camera.position.set(x,y,z);camera.lookAt(target);
}

/* =========================
   18. HUD / SAVE
========================= */
function updateHUD(){
 $("cash").textContent=cash;
 $("bank").textContent=bank;
 $("health").textContent="Health: "+health;
 const n=nearestPlace();
 $("location").textContent="Location: "+(n.place?n.place[0]:"City");
 const v=activeVehicle;
 $("speed").textContent=v?Math.round(Math.abs(v.speed)*3.6)+" km/h":"0 km/h";
 $("jobStatus").textContent=currentJob?
 "Job: "+currentJob.type+" | "+currentJob.stage+
 (currentJob.type==="bus"?" | Passengers: "+busPassengers:""):"Job: None";
}
function save(){
 const data={cash,bank,health,inventory,installed:[...installed],rentalCars};
 try{localStorage.setItem("indianLifeP5",JSON.stringify(data))}catch(e){}
}
function load(){
 try{
  const d=JSON.parse(localStorage.getItem("indianLifeP5")||"{}");
  if(d.cash!==undefined)cash=d.cash;
  if(d.bank!==undefined)bank=d.bank;
  if(d.health!==undefined)health=d.health;
  if(d.inventory)inventory=d.inventory;
  if(d.installed)installed=new Set(d.installed);
  if(d.rentalCars!==undefined)rentalCars=d.rentalCars;
 }catch(e){console.warn("Save data could not be loaded")}
}
let toastTimer;
function toast(message){
 const t=$("toast");t.textContent=message;t.style.display="block";
 clearTimeout(toastTimer);toastTimer=setTimeout(()=>t.style.display="none",2200);
}
function closeDialog(){$("dialog").style.display="none"}

/* =========================
   19. MAIN GAME LOOP
========================= */
function animate(now){
 requestAnimationFrame(animate);
 const dt=Math.min((now-lastTime)/1000||0,.04);lastTime=now;
 const t=now/1000;
 updatePlayer(dt,t);
 for(const v of vehicles)updateVehicle(v,dt);
 updateTaxi(dt);
 updateNPCs(dt,t);
 updateCamera();
 drawMini();
 if($("worldMap").style.display==="block")drawWorldMap();
 updateHUD();
 renderer.render(scene,camera);
}
load();
updateHUD();
gameReady=true;
requestAnimationFrame(animate);

/* =========================
   20. RESIZE
========================= */
addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;
 camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
});

/* =========================
   21. AUTO SAVE
========================= */
setInterval(save,10000);
addEventListener("beforeunload",save);
</script>
